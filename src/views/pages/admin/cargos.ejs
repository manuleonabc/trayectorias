<!DOCTYPE html>
<html lang="es" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Trayectorias - Cargos</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</head>
<body>
    <%- include('../../partials/msj') %>
    <%- include('../../partials/nav') %>

    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="h3 fw-bold mb-0">Cargos</h1>
                <p class="text-secondary mb-0">Gestionando: <%= institucion ? institucion.nombre : '—' %></p>
            </div>
        </div>

        <!-- Formulario de alta - institucion implicita por la sesion (ver /seleccionar-institucion) -->
        <div class="card mb-4">
            <div class="card-header">Nuevo cargo</div>
            <div class="card-body">
                <form action="/admin/cargos" method="POST" class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Rol</label>
                        <select name="rolId" class="form-select" required>
                            <option value="">Seleccioná un rol</option>
                            <% roles.forEach(function (rol) { %>
                            <option value="<%= rol._id %>"><%= rol.nombre %></option>
                            <% }); %>
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">CUPOF</label>
                        <input
                            type="text"
                            name="cupof"
                            class="form-control"
                            placeholder="Ej: 123456"
                            inputmode="numeric">
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">Clave</label>
                        <input type="text" name="clave" class="form-control" placeholder="Por defecto, la del rol">
                        <div class="form-text">Identifica al cargo en la URL, única por institución.</div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Turno</label>
                        <select name="turnoId" class="form-select">
                            <option value="">Sin turno fijo</option>
                            <% turnos.forEach(function (turno) { %>
                            <option value="<%= turno._id %>"><%= turno.nombre %></option>
                            <% }); %>
                        </select>
                    </div>

                    <div class="col-12">
                        <button type="submit" class="btn btn-primary">Crear cargo</button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Tabla de cargos -->
        <div class="card">
            <div class="card-header">Listado (<%= cargosConActiva.length %>)</div>
            <div class="card-body p-0">
                <% if (cargosConActiva.length === 0) { %>
                <p class="text-muted p-3 mb-0">No hay cargos creados.</p>
                <% } else { %>
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>CUPOF</th>
                            <th>Rol</th>
                            <th>Asignatura</th>
                            <th>Curso</th>
                            <th>Carga horaria</th>
                            <th>Turno</th>
                            <th>Ejerce hoy</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        <% cargosConActiva.forEach(function (item) { %>
                        <% const cargo = item.cargo, activa = item.activa; %>
                        <tr>
                            <td><%= cargo.cupof != null ? cargo.cupof : '—' %></td>
                            <td><%= cargo.rolId ? cargo.rolId.nombre : '—' %></td>
                            <td><%= cargo.asignaturaId ? cargo.asignaturaId.nombre : '—' %></td>
                            <td><%= cargo.cursoId ? cargo.cursoId.clave : '—' %></td>
                            <td>
                                <% if (cargo.asignaturaId) { %><%= cargo.asignaturaId.cargaHoraria %> hs
                                <% } else if (!cargo.rolId) { %>—
                                <% } else if (cargo.rolId.cargaHoraria != null) { %><%= cargo.rolId.cargaHoraria %> hs
                                <% } else { %>Según asignatura<% } %>
                            </td>
                            <td><%= cargo.turnoId ? cargo.turnoId.nombre : '—' %></td>
                            <td>
                                <% if (activa) { %>
                                    <%= activa.personaId.apellido %>, <%= activa.personaId.nombre %>
                                    <span class="badge text-bg-secondary"><%= activa.situacionRevista %></span>
                                <% } else { %>
                                    <span class="text-muted">Vacante</span>
                                <% } %>
                            </td>
                            <td class="text-end">
                                <% if (cargo.institucionId && cargo.institucionId.clave && cargo.clave) { %>
                                <a href="/admin/instituciones/<%= cargo.institucionId.clave %>/cargos/<%= cargo.clave %>" class="btn btn-outline-secondary btn-sm">Gestionar</a>
                                <% } else { %>
                                <span class="text-muted small me-2">Sin clave</span>
                                <% } %>
                                <a href="/admin/cargos/<%= cargo._id %>/editar" class="btn btn-outline-secondary btn-sm">Editar clave</a>
                            </td>
                        </tr>
                        <% }); %>
                    </tbody>
                </table>
                <% } %>
            </div>
        </div>
    </div>
</body>
</html>
