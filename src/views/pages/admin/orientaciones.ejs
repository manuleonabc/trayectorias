<!DOCTYPE html>
<html lang="es" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Trayectorias - Orientaciones</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</head>
<body>
    <%- include('../../partials/msj') %>
    <%- include('../../partials/nav') %>

    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="h3 fw-bold mb-0">Orientaciones</h1>
        </div>

        <!-- Formulario de alta -->
        <div class="card mb-4">
            <div class="card-header">Nueva orientación</div>
            <div class="card-body">
                <form action="/admin/orientaciones" method="POST" class="row g-3">
                    <div class="col-md-5">
                        <label class="form-label">Nombre</label>
                        <input type="text" name="nombre" class="form-control" placeholder="Ej: Arte - Música" required>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Nombre corto</label>
                        <input type="text" name="nombreCorto" class="form-control" placeholder="Ej: Arte" required>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Clave</label>
                        <input type="text" name="clave" class="form-control" placeholder="Ej: arte-mus" required>
                    </div>
                    <div class="col-md-2 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary w-100">Crear</button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Listado -->
        <div class="card">
            <div class="card-header">Listado (<%= orientaciones.length %>)</div>
            <div class="card-body p-0">
                <% if (orientaciones.length === 0) { %>
                <p class="text-muted p-3 mb-0">No hay orientaciones creadas.</p>
                <% } else { %>
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Clave</th>
                            <th>Nombre corto</th>
                            <th>Nombre</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        <% orientaciones.forEach(function (orientacion) { %>
                        <tr>
                            <td><%= orientacion.clave || '—' %></td>
                            <td><%= orientacion.nombreCorto || '—' %></td>
                            <td><%= orientacion.nombre %></td>
                            <td class="text-end">
                                <a href="/admin/orientaciones/<%= orientacion.clave %>/editar"
                                    class="btn btn-outline-secondary btn-sm">Editar</a>
                                <form action="/admin/orientaciones/<%= orientacion.clave %>/eliminar" method="POST"
                                    class="d-inline">
                                    <button type="submit" class="btn btn-outline-danger btn-sm">Eliminar</button>
                                </form>
                            </td>
                        </tr>
                        <% }); %>
                    </tbody>
                </table>
                <% } %>
            </div>
        </div>
    </div>
</body>
</html>
