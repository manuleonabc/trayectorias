<!DOCTYPE html>
<html lang="es" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Trayectorias - Instituciones</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</head>
<body>
    <%- include('../../partials/msj') %>
    <%- include('../../partials/nav') %>

    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="h3 fw-bold mb-0">Instituciones</h1>
        </div>

        <p class="text-secondary small">
            La clave es lo que identifica a cada institución en las URLs de cursos, turnos y cargos
            (en vez de un id interno) - toda institución necesita una para poder usar esas pantallas.
        </p>

        <div class="card">
            <div class="card-header">Listado (<%= instituciones.length %>)</div>
            <div class="card-body p-0">
                <% if (instituciones.length === 0) { %>
                <p class="text-muted p-3 mb-0">No hay instituciones registradas.</p>
                <% } else { %>
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>CUE</th>
                            <th>Nombre</th>
                            <th>Clave</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        <% instituciones.forEach(function (institucion) { %>
                        <tr>
                            <td><%= institucion.cue %></td>
                            <td><%= institucion.nombre %></td>
                            <td><%= institucion.clave || '—' %></td>
                            <td class="text-end">
                                <a href="/admin/instituciones/<%= institucion.cue %>/editar" class="btn btn-outline-secondary btn-sm">Editar clave</a>
                            </td>
                        </tr>
                        <% }); %>
                    </tbody>
                </table>
                <% } %>
            </div>
        </div>
    </div>
</body>
</html>
