<!DOCTYPE html>
<html lang="es" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Trayectorias - <%= cargo.rolId ? cargo.rolId.nombre : 'Cargo' %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</head>
<body>
    <%- include('../../partials/msj') %>
    <%- include('../../partials/nav') %>

    <div class="container py-4" style="max-width: 640px;">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="h3 fw-bold mb-0">
                <%= cargo.rolId ? cargo.rolId.nombre : '—' %>
                <% if (cargo.asignaturaId) { %> — <%= cargo.asignaturaId.nombre %><% } %>
                <% if (cargo.cursoId) { %> (<%= cargo.cursoId.clave %>)<% } %>
                <span class="text-secondary fs-6 fw-normal">
                    — <%= cargo.institucionId ? cargo.institucionId.nombre : '—' %>
                </span>
            </h1>
            <a href="/admin/cargos" class="btn btn-outline-secondary btn-sm">Volver</a>
        </div>

        <div class="card">
            <div class="card-body">
                <form action="/admin/cargos/<%= cargo._id %>" method="POST" class="row g-3">
                    <div class="col-12">
                        <label class="form-label">Clave</label>
                        <input type="text" name="clave" class="form-control" value="<%= cargo.clave || '' %>" placeholder="Ej: preceptor" required>
                        <div class="form-text">Identifica a este cargo en las URLs, única dentro de la institución.</div>
                    </div>
                    <div class="col-12">
                        <button type="submit" class="btn btn-primary">Guardar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</body>
</html>
