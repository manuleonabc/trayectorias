<!DOCTYPE html>
<html lang="es" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Trayectorias - Cursos</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</head>
<body>
    <%- include('../../partials/msj') %>
    <%- include('../../partials/nav') %>

    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="h3 fw-bold mb-0">Cursos</h1>
                <p class="text-secondary mb-0">Gestionando: <%= institucion ? institucion.nombre : '—' %></p>
            </div>
        </div>

        <!-- Formulario de alta - institucion implicita por la sesion (ver /seleccionar-institucion) -->
        <div class="card mb-4">
            <div class="card-header">Nuevo curso</div>
            <div class="card-body">
                <form id="formCurso" action="/admin/cursos" method="POST" class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label">Año</label>
                        <select name="anioId" id="anioSelect" class="form-select" required>
                            <option value="">Seleccioná un año</option>
                            <% anios.forEach(function (anio) { %>
                            <option value="<%= anio._id %>" data-clave="<%= anio.clave %>" data-ciclo="<%= anio.ciclo %>">
                                <%= anio.nombre %>
                            </option>
                            <% }); %>
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">División</label>
                        <input type="text" name="division" id="divisionInput" class="form-control" placeholder="Ej: A" required>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Turno</label>
                        <select name="turnoId" class="form-select" required>
                            <option value="">Seleccioná un turno</option>
                            <% turnos.forEach(function (turno) { %>
                            <option value="<%= turno._id %>"><%= turno.nombre %></option>
                            <% }); %>
                        </select>
                    </div>

                    <div class="col-md-4" id="orientacionWrap">
                        <label class="form-label">Orientación</label>
                        <select name="orientacionId" id="orientacionSelect" class="form-select">
                            <option value="">Seleccioná una orientación</option>
                            <% orientaciones.forEach(function (orientacion) { %>
                            <option value="<%= orientacion._id %>" data-corto="<%= orientacion.nombreCorto %>">
                                <%= orientacion.nombre %>
                            </option>
                            <% }); %>
                        </select>
                        <div class="form-text">Solo para años de ciclo superior.</div>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Clave</label>
                        <input type="text" name="clave" id="claveInput" class="form-control" placeholder="Ej: 4A-CS" required>
                        <div class="form-text">Se sugiere sola con año + división + orientación, pero se puede editar.</div>
                    </div>

                    <div class="col-12">
                        <button type="submit" class="btn btn-primary">Crear curso</button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Tabla de cursos -->
        <div class="card">
            <div class="card-header">Listado (<%= cursosConCantidad.length %>)</div>
            <div class="card-body p-0">
                <% if (cursosConCantidad.length === 0) { %>
                <p class="text-muted p-3 mb-0">No hay cursos creados.</p>
                <% } else { %>
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Clave</th>
                            <th>Año</th>
                            <th>División</th>
                            <th>Turno</th>
                            <th>Orientación</th>
                            <th>Cargos de profesor</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        <% cursosConCantidad.forEach(function (item) { %>
                        <% const curso = item.curso; %>
                        <tr>
                            <td><%= curso.clave %></td>
                            <td><%= curso.anioId ? curso.anioId.nombre : '—' %></td>
                            <td><%= curso.division %></td>
                            <td><%= curso.turnoId ? curso.turnoId.nombre : '—' %></td>
                            <td><%= curso.orientacionId ? curso.orientacionId.nombre : '—' %></td>
                            <td><%= item.cantidadCargos %></td>
                            <td class="text-end">
                                <% if (curso.institucionId && curso.institucionId.clave) { %>
                                <a href="/admin/instituciones/<%= curso.institucionId.clave %>/cursos/<%= curso.clave %>" class="btn btn-outline-secondary btn-sm">Gestionar</a>
                                <% } else { %>
                                <span class="text-muted small">Institución sin clave</span>
                                <% } %>
                            </td>
                        </tr>
                        <% }); %>
                    </tbody>
                </table>
                <% } %>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const alertas = document.querySelectorAll('.auto-close');
            alertas.forEach(function (alerta) {
                setTimeout(function () {
                    new bootstrap.Alert(alerta).close();
                }, 5000);
            });

            // Sugiere la clave (año+division+orientacion) a medida que se completa el
            // resto del form, y muestra la orientacion solo para años de ciclo superior.
            // No pisa la clave si la persona ya la edito a mano.
            const anioSelect = document.getElementById('anioSelect');
            const divisionInput = document.getElementById('divisionInput');
            const orientacionWrap = document.getElementById('orientacionWrap');
            const orientacionSelect = document.getElementById('orientacionSelect');
            const claveInput = document.getElementById('claveInput');
            let ultimaSugerida = '';

            function esCicloSuperior() {
                const opt = anioSelect.selectedOptions[0];
                return !!(opt && opt.dataset.ciclo === 'superior');
            }

            function actualizarOrientacionVisible() {
                const superior = esCicloSuperior();
                orientacionWrap.style.display = superior ? '' : 'none';
                if (!superior) orientacionSelect.value = '';
            }

            function actualizarClave() {
                const anioOpt = anioSelect.selectedOptions[0];
                const claveAnio = anioOpt ? anioOpt.dataset.clave : '';
                const division = divisionInput.value.trim();
                const orientOpt = orientacionSelect.selectedOptions[0];
                const corto = (esCicloSuperior() && orientOpt && orientOpt.value) ? orientOpt.dataset.corto : '';

                if (!claveAnio || !division) return;

                const sugerida = claveAnio + division + (corto ? '-' + corto : '');
                if (claveInput.value === '' || claveInput.value === ultimaSugerida) {
                    claveInput.value = sugerida;
                    ultimaSugerida = sugerida;
                }
            }

            anioSelect.addEventListener('change', function () {
                actualizarOrientacionVisible();
                actualizarClave();
            });
            divisionInput.addEventListener('input', actualizarClave);
            orientacionSelect.addEventListener('change', actualizarClave);

            actualizarOrientacionVisible();
        });
    </script>
</body>
</html>
