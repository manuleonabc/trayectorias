<!DOCTYPE html>
<html lang="es" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Trayectorias - Editar <%= curso.clave %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</head>
<body>
    <%- include('../../partials/msj') %>
    <%- include('../../partials/nav') %>

    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="h3 fw-bold mb-0">Editar curso</h1>
                <p class="text-secondary mb-0">
                    <%= curso.institucionId.nombre %> · <%= curso.anioId.nombre %>
                    <% if (curso.orientacionId) { %> · <%= curso.orientacionId.nombre %><% } %>
                </p>
            </div>
            <a href="/admin/instituciones/<%= curso.institucionId.clave %>/cursos/<%= curso.clave %>" class="btn btn-outline-secondary btn-sm">Volver al curso</a>
        </div>

        <div class="card">
            <div class="card-body">
                <form action="/admin/instituciones/<%= curso.institucionId.clave %>/cursos/<%= curso.clave %>/editar" method="POST" class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label">División</label>
                        <input type="text" name="division" class="form-control" value="<%= curso.division %>" required>
                    </div>
                    <div class="col-md-5">
                        <label class="form-label">Turno</label>
                        <select name="turnoId" class="form-select" required>
                            <% turnos.forEach(function (turno) { %>
                            <option value="<%= turno._id %>" <%= String(turno._id) === String(curso.turnoId._id) ? 'selected' : '' %>>
                                <%= turno.nombre %>
                            </option>
                            <% }); %>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Clave</label>
                        <input type="text" name="clave" class="form-control" value="<%= curso.clave %>" required>
                    </div>
                    <div class="col-12">
                        <p class="text-secondary small mb-3">
                            El año y la orientación no se pueden cambiar acá: los cargos de
                            profesor ya generados dependen del plan de estudio original. Para
                            cambiarlos, hay que eliminar este curso (si no tiene estudiantes
                            inscriptos) y crear uno nuevo.
                        </p>
                        <button type="submit" class="btn btn-primary">Guardar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</body>
</html>
