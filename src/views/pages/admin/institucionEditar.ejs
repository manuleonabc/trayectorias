<!DOCTYPE html>
<html lang="es" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Trayectorias - <%= institucion.nombre %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</head>
<body>
    <%- include('../../partials/msj') %>
    <%- include('../../partials/nav') %>

    <div class="container py-4" style="max-width: 640px;">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="h3 fw-bold mb-0"><%= institucion.nombre %></h1>
            <a href="/admin/instituciones" class="btn btn-outline-secondary btn-sm">Volver</a>
        </div>

        <div class="card">
            <div class="card-body">
                <form action="/admin/instituciones/<%= institucion.cue %>" method="POST" class="row g-3">
                    <div class="col-12">
                        <label class="form-label">Clave</label>
                        <input type="text" name="clave" class="form-control" value="<%= institucion.clave || '' %>" placeholder="Ej: escuela-9" required>
                        <div class="form-text">Se usa en las URLs de cursos, turnos y cargos de esta institución.</div>
                    </div>
                    <div class="col-12">
                        <button type="submit" class="btn btn-primary">Guardar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</body>
</html>
