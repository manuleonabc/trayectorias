<!DOCTYPE html>
<html lang="es" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Trayectorias - Editar rol</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</head>
<body>
    <%- include('../../partials/msj') %>
    <%- include('../../partials/nav') %>

    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="h3 fw-bold mb-0">Editar rol</h1>
            <a href="/admin/roles" class="btn btn-outline-secondary btn-sm">Volver a roles</a>
        </div>

        <div class="card">
            <div class="card-body">
                <form action="/admin/roles/<%= rol.clave %>" method="POST" class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label">Nombre</label>
                        <input type="text" name="nombre" class="form-control" value="<%= rol.nombre %>" required>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Nombre corto</label>
                        <input type="text" name="nombreCorto" class="form-control" value="<%= rol.nombreCorto %>" required>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Clave</label>
                        <input type="text" name="clave" class="form-control" value="<%= rol.clave %>" required>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Jerarquía</label>
                        <input type="number" name="jerarquia" class="form-control" value="<%= rol.jerarquia %>" required>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Carga horaria</label>
                        <input type="number" name="cargaHoraria" class="form-control" min="1" step="0.5" value="<%= rol.cargaHoraria != null ? rol.cargaHoraria : '' %>">
                        <div class="form-text">Dejá vacío si depende de la asignatura (ej: Profesor/a).</div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Nivel de acceso</label>
                        <select name="nivelAcceso" class="form-select">
                            <option value="ninguno" <%= (rol.nivelAcceso || 'ninguno') === 'ninguno' ? 'selected' : '' %>>Ninguno</option>
                            <option value="profesor" <%= rol.nivelAcceso === 'profesor' ? 'selected' : '' %>>Profesor (solo su materia/curso)</option>
                            <option value="preceptor" <%= rol.nivelAcceso === 'preceptor' ? 'selected' : '' %>>Preceptor (sus cursos)</option>
                            <option value="total" <%= rol.nivelAcceso === 'total' ? 'selected' : '' %>>Total (todo salvo baja real y plan de estudios)</option>
                        </select>
                        <div class="form-text">Qué puede hacer en /estudiantes alguien con este cargo activo.</div>
                    </div>
                    <div class="col-12">
                        <button type="submit" class="btn btn-primary">Guardar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</body>
</html>
