<!DOCTYPE html>
<html lang="es" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Trayectorias - <%= cargo.rolId ? cargo.rolId.nombre : 'Cargo' %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</head>
<body>
    <%- include('../../partials/msj') %>
    <%- include('../../partials/nav') %>

    <% const urlCargo = `/admin/instituciones/${cargo.institucionId.clave}/cargos/${cargo.clave}`; %>

    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="h3 fw-bold mb-0">
                    <%= cargo.rolId ? cargo.rolId.nombre : '—' %>
                    <% if (cargo.asignaturaId) { %> — <%= cargo.asignaturaId.nombre %><% } %>
                    <% if (cargo.cursoId) { %> (<%= cargo.cursoId.clave %>)<% } %>
                    <span class="text-secondary fs-6 fw-normal">
                        — <%= cargo.institucionId ? cargo.institucionId.nombre : '—' %>
                        <% if (cargo.turnoId) { %> · <%= cargo.turnoId.nombre %><% } %>
                        <% if (cargo.cupof) { %> · CUPOF <%= cargo.cupof %><% } %>
                    </span>
                </h1>
            </div>
            <a href="/admin/cargos" class="btn btn-outline-secondary btn-sm">Volver a cargos</a>
        </div>

        <!-- Estado actual -->
        <div class="card mb-4">
            <div class="card-header">Estado actual</div>
            <div class="card-body">
                <% if (!activa) { %>
                <p class="text-muted mb-0">Vacante — no tiene ninguna designación vigente.</p>
                <% } else { %>
                <p class="mb-1">
                    <strong><%= activa.personaId.apellido %>, <%= activa.personaId.nombre %></strong>
                    <span class="badge text-bg-primary"><%= activa.situacionRevista %></span>
                    <span class="text-secondary">— desde <%= activa.fechaAlta.toLocaleDateString('es-AR') %></span>
                </p>
                <% if (cubiertaPorActiva) { %>
                <p class="text-secondary mb-0">
                    Cubre a <%= cubiertaPorActiva.personaId.apellido %>, <%= cubiertaPorActiva.personaId.nombre %>
                    (<%= cubiertaPorActiva.situacionRevista %>)
                    <% if (licenciaDeCubierta) { %> — <%= licenciaDeCubierta.motivo %><% } %>
                </p>
                <% } %>
                <form action="<%= urlCargo %>/designaciones/<%= activa._id %>/baja" method="POST" class="row g-2 mt-2">
                    <div class="col-md-4">
                        <input type="date" name="fechaBaja" class="form-control form-control-sm" required>
                    </div>
                    <div class="col-md-5">
                        <input type="text" name="motivoBaja" class="form-control form-control-sm" placeholder="Motivo de la baja (ej: renuncia, jubilación)" required>
                    </div>
                    <div class="col-md-3">
                        <button type="submit" class="btn btn-outline-danger btn-sm w-100">Dar de baja definitiva</button>
                    </div>
                </form>
                <% } %>
            </div>
        </div>

        <!-- Alta como titular/provisional/interino: solo si el cargo esta vacante -->
        <% if (!activa) { %>
        <div class="card mb-4">
            <div class="card-header">Designar</div>
            <div class="card-body">
                <form action="<%= urlCargo %>/designaciones" method="POST" class="row g-3">
                    <div class="col-md-5">
                        <label class="form-label">Persona</label>
                        <select name="personaId" class="form-select" required>
                            <option value="">Seleccioná una persona</option>
                            <% personas.forEach(function (persona) { %>
                            <option value="<%= persona._id %>"><%= persona.apellido %>, <%= persona.nombre %></option>
                            <% }); %>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Situación de revista</label>
                        <select name="situacionRevista" class="form-select" required>
                            <option value="titular">Titular</option>
                            <option value="provisional">Provisional</option>
                            <option value="interino">Interino</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Fecha de alta</label>
                        <input type="date" name="fechaAlta" class="form-control" required>
                    </div>
                    <div class="col-md-1 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary w-100">+</button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Solicitudes pendientes de este cargo (ver SolicitudCargo) - solo tiene sentido
             si esta vacante, mismo criterio que el card de Designar de arriba. -->
        <% if (solicitudesPendientes.length > 0) { %>
        <div class="card mb-4">
            <div class="card-header">Solicitudes pendientes (<%= solicitudesPendientes.length %>)</div>
            <div class="card-body">
                <% solicitudesPendientes.forEach(function (solicitud) { %>
                <div class="border-bottom pb-3 mb-3">
                    <p class="mb-2">
                        <strong><%= solicitud.personaId.apellido %>, <%= solicitud.personaId.nombre %></strong>
                        <span class="text-secondary small">— <%= solicitud.createdAt.toLocaleDateString('es-AR') %></span>
                        <% if (solicitud.mensaje) { %><br><span class="text-secondary"><%= solicitud.mensaje %></span><% } %>
                    </p>
                    <div class="row g-2">
                        <div class="col-12 col-md-6">
                            <form action="/admin/solicitudes-cargo/<%= solicitud._id %>/aprobar" method="POST" class="row g-2">
                                <input type="hidden" name="volver" value="<%= urlCargo %>">
                                <div class="col-5">
                                    <select name="situacionRevista" class="form-select form-select-sm" required>
                                        <option value="titular">Titular</option>
                                        <option value="provisional">Provisional</option>
                                        <option value="interino">Interino</option>
                                    </select>
                                </div>
                                <div class="col-4">
                                    <input type="date" name="fechaAlta" class="form-control form-control-sm" required>
                                </div>
                                <div class="col-3">
                                    <button type="submit" class="btn btn-primary btn-sm w-100">Aprobar</button>
                                </div>
                            </form>
                        </div>
                        <div class="col-12 col-md-6">
                            <form action="/admin/solicitudes-cargo/<%= solicitud._id %>/rechazar" method="POST" class="row g-2">
                                <input type="hidden" name="volver" value="<%= urlCargo %>">
                                <div class="col-8">
                                    <input type="text" name="motivoRechazo" class="form-control form-control-sm" placeholder="Motivo del rechazo" required>
                                </div>
                                <div class="col-4">
                                    <button type="submit" class="btn btn-outline-danger btn-sm w-100">Rechazar</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
                <% }); %>
            </div>
        </div>
        <% } %>
        <% } %>

        <!-- Alta de suplente: solo si hay alguien activo para cubrir, con su licencia -->
        <% if (activa) { %>
        <div class="card mb-4">
            <div class="card-header">Designar suplente de <%= activa.personaId.apellido %>, <%= activa.personaId.nombre %></div>
            <div class="card-body">
                <% if (licenciaVigenteDeActiva) { %>
                <p class="mb-3">
                    Licencia vigente: <strong><%= licenciaVigenteDeActiva.motivo %></strong>
                    desde <%= licenciaVigenteDeActiva.fechaInicio.toLocaleDateString('es-AR') %>.
                </p>
                <% } %>
                <form action="<%= urlCargo %>/suplentes" method="POST" class="row g-3">
                    <% if (licenciaVigenteDeActiva) { %>
                    <input type="hidden" name="licenciaId" value="<%= licenciaVigenteDeActiva._id %>">
                    <% } %>
                    <div class="col-md-4">
                        <label class="form-label">Persona (suplente)</label>
                        <select name="personaId" class="form-select" required>
                            <option value="">Seleccioná una persona</option>
                            <% personas.forEach(function (persona) { %>
                            <option value="<%= persona._id %>"><%= persona.apellido %>, <%= persona.nombre %></option>
                            <% }); %>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Fecha de alta</label>
                        <input type="date" name="fechaAlta" class="form-control" required>
                    </div>
                    <% if (!licenciaVigenteDeActiva) { %>
                    <div class="col-md-3">
                        <label class="form-label">Motivo de licencia</label>
                        <input type="text" name="motivoLicencia" class="form-control" placeholder="Ej: Licencia médica" required>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Inicio de licencia</label>
                        <input type="date" name="fechaInicioLicencia" class="form-control">
                    </div>
                    <% } %>
                    <div class="col-md-1 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary w-100">+</button>
                    </div>
                </form>
                <% if (!licenciaVigenteDeActiva) { %>
                <p class="text-secondary small mt-2 mb-0">
                    Da de alta la licencia de <%= activa.personaId.apellido %> y el suplente en el mismo paso.
                </p>
                <% } %>
            </div>
        </div>
        <% } %>

        <!-- Cursos a cargo: no aplica a los cargos de profesor, que ya tienen su curso fijo -->
        <% if (!cargo.asignaturaId) { %>
        <div class="card mb-4">
            <div class="card-header">Cursos a cargo</div>
            <div class="card-body">
                <% if (cursosDelCargo.length === 0) { %>
                <p class="text-muted">Este cargo todavía no tiene cursos asignados.</p>
                <% } else { %>
                <table class="table table-sm mb-3">
                    <thead>
                        <tr>
                            <th>Año lectivo</th>
                            <th>Curso</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        <% cursosDelCargo.forEach(function (cargoCurso) { %>
                        <tr>
                            <td><%= cargoCurso.anioLectivo %></td>
                            <td><%= cargoCurso.cursoId ? cargoCurso.cursoId.clave : '—' %></td>
                            <td class="text-end">
                                <form action="<%= urlCargo %>/cursos/<%= cargoCurso._id %>/eliminar" method="POST">
                                    <button type="submit" class="btn btn-outline-danger btn-sm">Quitar</button>
                                </form>
                            </td>
                        </tr>
                        <% }); %>
                    </tbody>
                </table>
                <% } %>

                <form action="<%= urlCargo %>/cursos" method="POST" class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Curso</label>
                        <select name="cursoId" class="form-select" required>
                            <option value="">Seleccioná un curso</option>
                            <% cursosDeLaInstitucion.forEach(function (curso) { %>
                            <option value="<%= curso._id %>"><%= curso.clave %></option>
                            <% }); %>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Año lectivo</label>
                        <input type="number" name="anioLectivo" class="form-control" value="<%= anioActual %>" required>
                    </div>
                    <div class="col-md-3 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary w-100">Asignar</button>
                    </div>
                </form>
            </div>
        </div>
        <% } %>

        <!-- Historial -->
        <div class="card">
            <div class="card-header">Historial (<%= historial.length %>)</div>
            <div class="card-body p-0">
                <% if (historial.length === 0) { %>
                <p class="text-muted p-3 mb-0">Este cargo todavía no tuvo designaciones.</p>
                <% } else { %>
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Persona</th>
                            <th>Situación</th>
                            <th>Alta</th>
                            <th>Baja</th>
                            <th>Motivo de baja</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% historial.forEach(function (designacion) { %>
                        <tr>
                            <td><%= designacion.personaId.apellido %>, <%= designacion.personaId.nombre %></td>
                            <td><%= designacion.situacionRevista %></td>
                            <td><%= designacion.fechaAlta.toLocaleDateString('es-AR') %></td>
                            <td><%= designacion.fechaBaja ? designacion.fechaBaja.toLocaleDateString('es-AR') : '—' %></td>
                            <td><%= designacion.motivoBaja || '—' %></td>
                        </tr>
                        <% }); %>
                    </tbody>
                </table>
                <% } %>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const alertas = document.querySelectorAll('.auto-close');
            alertas.forEach(function (alerta) {
                setTimeout(function () {
                    new bootstrap.Alert(alerta).close();
                }, 5000);
            });
        });
    </script>
</body>
</html>
