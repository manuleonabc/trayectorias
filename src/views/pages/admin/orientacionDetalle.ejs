<!DOCTYPE html>
<html lang="es" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Trayectorias - <%= anio.nombre %> · <%= orientacion.nombre %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</head>
<body>
    <%- include('../../partials/msj') %>
    <%- include('../../partials/nav') %>

    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="h3 fw-bold mb-0">
                <%= anio.nombre %>
                <span class="text-secondary fs-6 fw-normal">— <%= orientacion.nombre %></span>
            </h1>
            <a href="/admin/anios/<%= anio.clave %>" class="btn btn-outline-secondary btn-sm">Volver al año</a>
        </div>

        <!-- Formulario para agregar materia especifica -->
        <div class="card mb-4">
            <div class="card-header">Agregar materia específica</div>
            <div class="card-body">
                <form action="/admin/anios/<%= anio.clave %>/orientaciones/<%= orientacion.clave %>/filas" method="POST" class="row g-3">
                    <div class="col-md-2">
                        <label class="form-label">Clave</label>
                        <input type="text" name="clave" class="form-control" placeholder="Ej: ECO" required>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Nombre</label>
                        <input type="text" name="nombre" class="form-control" placeholder="Ej: Economía Política" required>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Nombre corto</label>
                        <input type="text" name="nombreCorto" class="form-control" placeholder="Ej: Eco. Política" required>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Carga horaria</label>
                        <input type="number" name="cargaHoraria" class="form-control" min="1" required>
                    </div>
                    <div class="col-md-1">
                        <label class="form-label">Orden</label>
                        <input type="number" name="orden" class="form-control" min="1" required>
                    </div>
                    <div class="col-md-2 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary w-100">Agregar</button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Listado de materias -->
        <div class="card">
            <div class="card-header">Materias (<%= filas.length %>)</div>
            <div class="card-body p-0">
                <% if (filas.length === 0) { %>
                <p class="text-muted p-3 mb-0">Esta orientación todavía no tiene materias.</p>
                <% } else { %>
                <table class="table table-hover mb-0 align-middle">
                    <thead>
                        <tr>
                            <th>Orden</th>
                            <th>Clave</th>
                            <th>Nombre</th>
                            <th>Nombre corto</th>
                            <th>Carga horaria</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        <% filas.forEach(function (fila) { %>
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-1">
                                    <form action="/admin/anios/<%= anio.clave %>/orientaciones/<%= orientacion.clave %>/filas/<%= fila.clave %>/subir" method="POST">
                                        <button type="submit" class="btn btn-outline-secondary btn-sm" title="Subir">↑</button>
                                    </form>
                                    <span><%= fila.orden %></span>
                                    <form action="/admin/anios/<%= anio.clave %>/orientaciones/<%= orientacion.clave %>/filas/<%= fila.clave %>/bajar" method="POST">
                                        <button type="submit" class="btn btn-outline-secondary btn-sm" title="Bajar">↓</button>
                                    </form>
                                </div>
                            </td>
                            <td><%= fila.clave %></td>
                            <td><%= fila.nombre %></td>
                            <td><%= fila.nombreCorto || '—' %></td>
                            <td>
                                <form
                                    action="/admin/anios/<%= anio.clave %>/orientaciones/<%= orientacion.clave %>/filas/<%= fila.clave %>/ajustar"
                                    method="POST" class="d-flex gap-1 align-items-center">
                                    <input type="number" name="cargaHoraria" value="<%= fila.cargaHoraria %>" min="1"
                                        class="form-control form-control-sm" style="width: 65px;">
                                    <span class="text-secondary small">hs</span>
                                    <button type="submit" class="btn btn-outline-secondary btn-sm">Guardar</button>
                                </form>
                            </td>
                            <td class="text-end">
                                <a href="/admin/anios/<%= anio.clave %>/orientaciones/<%= orientacion.clave %>/filas/<%= fila.clave %>/editar"
                                    class="btn btn-outline-secondary btn-sm">Editar</a>
                                <form
                                    action="/admin/anios/<%= anio.clave %>/orientaciones/<%= orientacion.clave %>/filas/<%= fila.clave %>/quitar"
                                    method="POST" class="d-inline">
                                    <button type="submit" class="btn btn-outline-danger btn-sm">Quitar</button>
                                </form>
                            </td>
                        </tr>
                        <% }); %>
                    </tbody>
                </table>
                <% } %>
            </div>
        </div>
    </div>
</body>
</html>
