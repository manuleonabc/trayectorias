<!DOCTYPE html>
<html lang="es" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Trayectorias - Turnos</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</head>
<body>
    <%- include('../../partials/msj') %>
    <%- include('../../partials/nav') %>

    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="h3 fw-bold mb-0">Turnos</h1>
                <p class="text-secondary mb-0">Gestionando: <%= institucion ? institucion.nombre : '—' %></p>
            </div>
        </div>

        <!-- Formulario de alta - institucion implicita por la sesion (ver /seleccionar-institucion) -->
        <div class="card mb-4">
            <div class="card-header">Nuevo turno</div>
            <div class="card-body">
                <form action="/admin/turnos" method="POST" class="row g-3">
                    <div class="col-md-5">
                        <label class="form-label">Nombre</label>
                        <input type="text" name="nombre" class="form-control" placeholder="Ej: Mañana" required>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Clave</label>
                        <input type="text" name="clave" class="form-control" placeholder="Ej: manana" required>
                    </div>
                    <div class="col-md-1 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary w-100">Crear</button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Tabla de turnos -->
        <div class="card">
            <div class="card-header">Listado (<%= turnos.length %>)</div>
            <div class="card-body p-0">
                <% if (turnos.length === 0) { %>
                <p class="text-muted p-3 mb-0">No hay turnos creados.</p>
                <% } else { %>
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>Módulos</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        <% turnos.forEach(function (turno) { %>
                        <tr>
                            <td><%= turno.nombre %></td>
                            <td><%= turno.modulos.length %></td>
                            <td>
                                <% if (turno.institucionId && turno.institucionId.clave) { %>
                                <a href="/admin/instituciones/<%= turno.institucionId.clave %>/turnos/<%= turno.clave %>" class="btn btn-outline-secondary btn-sm">
                                    Ver / agregar módulos
                                </a>
                                <% } else { %>
                                <span class="text-muted small">Institución sin clave — <a href="/admin/instituciones">asignale una</a></span>
                                <% } %>
                            </td>
                        </tr>
                        <% }); %>
                    </tbody>
                </table>
                <% } %>
            </div>
        </div>
    </div>
</body>
</html>
