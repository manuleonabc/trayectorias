<!DOCTYPE html>
<html lang="es" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Trayectorias - Solicitudes de cargo</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</head>
<body>
    <%- include('../../partials/msj') %>
    <%- include('../../partials/nav') %>

    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="h3 fw-bold mb-0">Solicitudes de cargo</h1>
        </div>

        <div class="card">
            <div class="card-header">Pendientes (<%= solicitudes.length %>)</div>
            <div class="card-body p-0">
                <% if (solicitudes.length === 0) { %>
                <p class="text-muted p-3 mb-0">No hay solicitudes pendientes.</p>
                <% } else { %>
                <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead>
                        <tr>
                            <th>Persona</th>
                            <th>Cargo</th>
                            <th>Mensaje</th>
                            <th>Aprobar</th>
                            <th>Rechazar</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% solicitudes.forEach(function (solicitud) { %>
                        <% const cargo = solicitud.cargoId; %>
                        <tr>
                            <td>
                                <%= solicitud.personaId.apellido %>, <%= solicitud.personaId.nombre %>
                                <div class="text-secondary small"><%= solicitud.createdAt.toLocaleDateString('es-AR') %></div>
                            </td>
                            <td>
                                <%= cargo && cargo.rolId ? cargo.rolId.nombre : '—' %>
                                <div class="text-secondary small">
                                    <%= cargo && cargo.institucionId ? cargo.institucionId.nombre : '—' %>
                                </div>
                            </td>
                            <td><%= solicitud.mensaje || '—' %></td>
                            <td>
                                <form action="/admin/solicitudes-cargo/<%= solicitud._id %>/aprobar" method="POST" class="d-flex flex-column gap-1" style="min-width: 220px;">
                                    <select name="situacionRevista" class="form-select form-select-sm" required>
                                        <option value="titular">Titular</option>
                                        <option value="provisional">Provisional</option>
                                        <option value="interino">Interino</option>
                                    </select>
                                    <input type="date" name="fechaAlta" class="form-control form-control-sm" required>
                                    <button type="submit" class="btn btn-primary btn-sm">Aprobar y designar</button>
                                </form>
                            </td>
                            <td>
                                <form action="/admin/solicitudes-cargo/<%= solicitud._id %>/rechazar" method="POST" class="d-flex flex-column gap-1" style="min-width: 200px;">
                                    <input type="text" name="motivoRechazo" class="form-control form-control-sm" placeholder="Motivo del rechazo" required>
                                    <button type="submit" class="btn btn-outline-danger btn-sm">Rechazar</button>
                                </form>
                            </td>
                        </tr>
                        <% }); %>
                    </tbody>
                </table>
                </div>
                <% } %>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const alertas = document.querySelectorAll('.auto-close');
            alertas.forEach(function (alerta) {
                setTimeout(function () {
                    new bootstrap.Alert(alerta).close();
                }, 5000);
            });
        });
    </script>
</body>
</html>
