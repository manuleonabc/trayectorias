<!DOCTYPE html>
<html lang="es" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Trayectorias - <%= anio.nombre %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</head>
<body>
    <%- include('../../partials/msj') %>
    <%- include('../../partials/nav') %>

    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="h3 fw-bold mb-0">
                <%= anio.nombre %>
                <span class="text-secondary fs-6 fw-normal">— ciclo <%= anio.ciclo %></span>
            </h1>
            <a href="/admin/anios" class="btn btn-outline-secondary btn-sm">Volver a años</a>
        </div>

        <!-- Formulario para agregar materia a la plantilla -->
        <div class="card mb-4">
            <div class="card-header">
                <%= anio.ciclo === 'basico' ? 'Agregar materia' : 'Agregar materia común (plantilla)' %>
            </div>
            <div class="card-body">
                <form action="/admin/anios/<%= anio.clave %>/plantilla" method="POST" class="row g-3">
                    <div class="col-md-2">
                        <label class="form-label">Clave</label>
                        <input type="text" name="clave" class="form-control" placeholder="Ej: MAT" required>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Nombre</label>
                        <input type="text" name="nombre" class="form-control" placeholder="Ej: Matemática" required>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Nombre corto</label>
                        <input type="text" name="nombreCorto" class="form-control" placeholder="Ej: Mate" required>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Carga horaria</label>
                        <input type="number" name="cargaHoraria" class="form-control" min="1" required>
                    </div>
                    <div class="col-md-1">
                        <label class="form-label">Orden</label>
                        <input type="number" name="orden" class="form-control" min="1" required>
                    </div>
                    <div class="col-md-2 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary w-100">Agregar</button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Plantilla / plan definitivo -->
        <div class="card mb-4">
            <div class="card-header">
                <%= anio.ciclo === 'basico' ? 'Plan de estudio' : 'Materias comunes (plantilla)' %>
                (<%= plantilla.length %>)
            </div>
            <div class="card-body p-0">
                <% if (plantilla.length === 0) { %>
                <p class="text-muted p-3 mb-0">Todavía no hay materias cargadas.</p>
                <% } else { %>
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Orden</th>
                            <th>Clave</th>
                            <th>Nombre</th>
                            <th>Nombre corto</th>
                            <th>Carga horaria</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        <% plantilla.forEach(function (fila) { %>
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-1">
                                    <form action="/admin/anios/<%= anio.clave %>/filas/<%= fila.clave %>/subir" method="POST">
                                        <button type="submit" class="btn btn-outline-secondary btn-sm" title="Subir">↑</button>
                                    </form>
                                    <span><%= fila.orden %></span>
                                    <form action="/admin/anios/<%= anio.clave %>/filas/<%= fila.clave %>/bajar" method="POST">
                                        <button type="submit" class="btn btn-outline-secondary btn-sm" title="Bajar">↓</button>
                                    </form>
                                </div>
                            </td>
                            <td><%= fila.clave %></td>
                            <td><%= fila.nombre %></td>
                            <td><%= fila.nombreCorto || '—' %></td>
                            <td><%= fila.cargaHoraria %> hs</td>
                            <td class="text-end">
                                <a href="/admin/anios/<%= anio.clave %>/filas/<%= fila.clave %>/editar"
                                    class="btn btn-outline-secondary btn-sm">Editar</a>
                            </td>
                        </tr>
                        <% }); %>
                    </tbody>
                </table>
                <% } %>
            </div>
        </div>

        <% if (anio.ciclo === 'superior') { %>
        <!-- Orientaciones ya creadas para este año -->
        <div class="card mb-4">
            <div class="card-header">Orientaciones (<%= orientacionesUsadas.length %>)</div>
            <div class="card-body p-0">
                <% if (orientacionesUsadas.length === 0) { %>
                <p class="text-muted p-3 mb-0">Todavía no se agregó ninguna orientación a este año.</p>
                <% } else { %>
                <table class="table table-hover mb-0">
                    <tbody>
                        <% orientacionesUsadas.forEach(function (orientacion) { %>
                        <tr>
                            <td><%= orientacion.nombre %></td>
                            <td class="text-end">
                                <a href="/admin/anios/<%= anio.clave %>/orientaciones/<%= orientacion.clave %>"
                                    class="btn btn-outline-secondary btn-sm">
                                    Ver / editar
                                </a>
                            </td>
                        </tr>
                        <% }); %>
                    </tbody>
                </table>
                <% } %>
            </div>
        </div>

        <!-- Agregar orientacion -->
        <div class="card">
            <div class="card-header">Agregar orientación a este año</div>
            <div class="card-body">
                <% if (orientacionesDisponibles.length === 0) { %>
                <p class="text-muted mb-0">
                    No hay más orientaciones para agregar (o todavía no creaste ninguna en
                    <a href="/admin/orientaciones">Orientaciones</a>).
                </p>
                <% } else { %>
                <form action="/admin/anios/<%= anio.clave %>/orientaciones" method="POST" class="row g-3">
                    <div class="col-md-8">
                        <select name="orientacionId" class="form-select" required>
                            <option value="">Seleccioná una orientación</option>
                            <% orientacionesDisponibles.forEach(function (orientacion) { %>
                            <option value="<%= orientacion._id %>"><%= orientacion.nombre %></option>
                            <% }); %>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <button type="submit" class="btn btn-primary w-100">
                            Agregar (clona las materias comunes)
                        </button>
                    </div>
                </form>
                <% } %>
            </div>
        </div>
        <% } %>
    </div>
</body>
</html>
