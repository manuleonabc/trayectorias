<!DOCTYPE html>
<html lang="es" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Trayectorias - Editar orientación</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</head>
<body>
    <%- include('../../partials/msj') %>
    <%- include('../../partials/nav') %>

    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="h3 fw-bold mb-0">Editar orientación</h1>
            <a href="/admin/orientaciones" class="btn btn-outline-secondary btn-sm">Volver</a>
        </div>

        <div class="card">
            <div class="card-body">
                <form action="/admin/orientaciones/<%= orientacion.clave %>" method="POST" class="row g-3">
                    <div class="col-md-5">
                        <label class="form-label">Nombre</label>
                        <input type="text" name="nombre" class="form-control" value="<%= orientacion.nombre %>" required>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Nombre corto</label>
                        <input type="text" name="nombreCorto" class="form-control" value="<%= orientacion.nombreCorto || '' %>" required>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Clave</label>
                        <input type="text" name="clave" class="form-control" value="<%= orientacion.clave || '' %>" required>
                    </div>
                    <div class="col-12">
                        <button type="submit" class="btn btn-primary">Guardar cambios</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</body>
</html>
