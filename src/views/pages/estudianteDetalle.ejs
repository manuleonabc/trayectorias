<!DOCTYPE html>
<html lang="es" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Trayectorias - <%= estudiante.personaId.apellido %>, <%= estudiante.personaId.nombre %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</head>
<body>
    <%- include('../partials/msj') %>
    <%- include('../partials/nav') %>

    <% const persona = estudiante.personaId; %>
    <% const claveEstudiante = persona.numeroDocumento || estudiante.legajo; %>

    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
            <div>
                <h1 class="h3 fw-bold mb-0">
                    <%= persona.apellido %>, <%= persona.nombre %>
                    <span class="text-secondary fs-6 fw-normal">
                        <% if (persona.tipoDocumento === 'DNI' && persona.numeroDocumento) { %>
                        — DNI <%= persona.numeroDocumento %><% if (persona.estadoDni && persona.estadoDni !== 'Tiene el DNI físico') { %> (<%= persona.estadoDni %>)<% } %>
                        <% } else if (persona.tipoDocumento === 'Documento extranjero' && persona.numeroDocumento) { %>
                        — <%= persona.documentoExtranjeroTipo || 'Documento extranjero' %> <%= persona.numeroDocumento %>
                        <% } else if (persona.tipoDocumento === 'CPI') { %>
                        — CPI (en trámite de DNI) · Legajo <%= estudiante.legajo %>
                        <% } else { %>
                        — Indocumentado · Legajo <%= estudiante.legajo %>
                        <% } %>
                    </span>
                </h1>
            </div>
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-outline-primary btn-sm" data-bs-toggle="collapse"
                    data-bs-target="#formEditarEstudiante" aria-expanded="<%= mensajes.error ? 'true' : 'false' %>"
                    aria-controls="formEditarEstudiante">
                    <i class="bi bi-pencil"></i> Editar
                </button>
                <% if (usuario && usuario.rol === 'admin' && usuario.nivelPoder === 'total' && modoGestion) { %>
                <button type="button" class="btn btn-outline-danger btn-sm" data-bs-toggle="modal" data-bs-target="#modalEliminarEstudiante">
                    <i class="bi bi-trash"></i> Eliminar
                </button>
                <% } %>
                <a href="/estudiantes" class="btn btn-outline-secondary btn-sm">Volver a estudiantes</a>
            </div>
        </div>

        <% if (usuario && usuario.rol === 'admin' && usuario.nivelPoder === 'total' && modoGestion) { %>
        <!-- Baja real (borrado fisico) - solo admin en modo gestion con nivelPoder total
             (mismo guard que el servidor, ver requireAdmin en estudiante.router.js). Requiere
             tipear la clave exacta del estudiante para habilitar el boton, doble chequeo
             (JS + servidor) antes de borrar algo irreversible. -->
        <div class="modal fade" id="modalEliminarEstudiante" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title text-danger"><i class="bi bi-exclamation-triangle-fill"></i> Eliminar estudiante definitivamente</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <form action="/estudiantes/<%= claveEstudiante %>/eliminar" method="POST">
                        <div class="modal-body">
                            <div class="alert alert-danger">
                                Esto borra a <strong><%= persona.apellido %>, <%= persona.nombre %></strong> de la
                                base <strong>de forma permanente</strong>, junto con todas sus inscripciones,
                                materias cursadas y los vínculos con sus personas responsables (los adultos
                                responsables en sí no se borran, por si tienen otros hijos vinculados). No se
                                puede deshacer.
                            </div>
                            <label class="form-label" for="confirmarClaveEliminar">
                                Para confirmar, escribí la clave del estudiante (<code><%= claveEstudiante %></code>):
                            </label>
                            <input type="text" name="claveConfirmacion" id="confirmarClaveEliminar" class="form-control" autocomplete="off" required>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                            <button type="submit" id="btnConfirmarEliminar" class="btn btn-danger" disabled>
                                <i class="bi bi-trash"></i> Eliminar definitivamente
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        <% } %>

        <!-- Editar estudiante: colapsado por defecto, reusa los mismos partials que el
             alta (documentoFields/nacimientoFields/domicilioFields), precargados con
             idSufijo="Editar" para no chocar con los ids del form de "Agregar
             responsable" mas abajo, que tambien los usa. -->
        <div class="collapse<%= mensajes.error ? ' show' : '' %> mb-4" id="formEditarEstudiante">
            <div class="card">
                <div class="card-header">Editar estudiante</div>
                <div class="card-body">
                    <form action="/estudiantes/<%= claveEstudiante %>/editar" method="POST">
                        <div class="row g-3 mb-4">
                            <%- include('../partials/documentoFields', { persona, idSufijo: 'Editar' }) %>
                            <div class="col-12 col-sm-6">
                                <label class="form-label">Apellido</label>
                                <input type="text" name="apellido" class="form-control" value="<%= persona.apellido %>" required>
                            </div>
                            <div class="col-12 col-sm-6">
                                <label class="form-label">Nombre</label>
                                <input type="text" name="nombre" class="form-control" value="<%= persona.nombre %>" required>
                            </div>
                            <div class="col-6 col-sm-4 col-md-3">
                                <label class="form-label">CUIL <span class="text-secondary fw-normal">(opcional)</span></label>
                                <input type="text" name="cuil" class="form-control" inputmode="numeric" value="<%= persona.cuil || '' %>">
                            </div>
                            <div class="col-6 col-sm-4 col-md-3">
                                <label class="form-label">Fecha de nacimiento</label>
                                <input type="date" name="fechaNacimiento" class="form-control" value="<%= persona.fecha_nacimiento ? persona.fecha_nacimiento.toISOString().slice(0, 10) : '' %>">
                            </div>
                            <div class="col-6 col-sm-12 col-md-3">
                                <label class="form-label">Identidad de género</label>
                                <select name="genero" class="form-select">
                                    <option value="" <%= !persona.genero ? 'selected' : '' %>>Sin especificar</option>
                                    <option value="Mujer" <%= persona.genero === 'Mujer' ? 'selected' : '' %>>Mujer</option>
                                    <option value="Mujer trans / travesti" <%= persona.genero === 'Mujer trans / travesti' ? 'selected' : '' %>>Mujer trans / travesti</option>
                                    <option value="Varón" <%= persona.genero === 'Varón' ? 'selected' : '' %>>Varón</option>
                                    <option value="Varón trans / masculinidad trans" <%= persona.genero === 'Varón trans / masculinidad trans' ? 'selected' : '' %>>Varón trans / masculinidad trans</option>
                                    <option value="No binario" <%= persona.genero === 'No binario' ? 'selected' : '' %>>No binario</option>
                                    <option value="Otra" <%= persona.genero === 'Otra' ? 'selected' : '' %>>Otra</option>
                                    <option value="No desea responder" <%= persona.genero === 'No desea responder' ? 'selected' : '' %>>No desea responder</option>
                                </select>
                            </div>
                        </div>

                        <h2 class="h6 fw-bold d-flex align-items-center gap-2 mb-3">
                            <i class="bi bi-geo"></i> Nacimiento <span class="text-secondary fw-normal small">(opcional)</span>
                        </h2>
                        <div class="row g-3 mb-4">
                            <%- include('../partials/nacimientoFields', { persona, idSufijo: 'Editar' }) %>
                        </div>

                        <h2 class="h6 fw-bold d-flex align-items-center gap-2 mb-3">
                            <i class="bi bi-house"></i> Domicilio <span class="text-secondary fw-normal small">(opcional)</span>
                        </h2>
                        <div class="row g-3 mb-4">
                            <%- include('../partials/domicilioFields', { persona, idSufijo: 'Editar' }) %>
                        </div>

                        <h2 class="h6 fw-bold d-flex align-items-center gap-2 mb-3">
                            <i class="bi bi-telephone"></i> Teléfonos de contacto <span class="text-secondary fw-normal small">(opcional)</span>
                        </h2>
                        <div class="mb-4">
                            <div id="telefonosContainerEditar">
                                <% const telefonosEditar = (persona.telefonos && persona.telefonos.length > 0) ? persona.telefonos : [{}]; %>
                                <% telefonosEditar.forEach(function (telefono) { %>
                                <div class="row g-2 mb-2 align-items-center telefono-fila">
                                    <div class="col-5">
                                        <input type="text" name="telefonoDescripcion" class="form-control" placeholder="Ej: Mamá, Vecina" value="<%= telefono.descripcion || '' %>">
                                    </div>
                                    <div class="col-6">
                                        <div class="input-group">
                                            <span class="input-group-text"><i class="bi bi-telephone"></i></span>
                                            <input type="tel" name="telefonoNumero" class="form-control" placeholder="Ej: 11 5555-5555" autocomplete="tel" value="<%= telefono.numero || '' %>">
                                        </div>
                                    </div>
                                    <div class="col-1">
                                        <button type="button" class="btn btn-outline-danger btn-quitar-telefono" aria-label="Quitar">&times;</button>
                                    </div>
                                </div>
                                <% }); %>
                            </div>
                            <button type="button" id="btnAgregarTelefonoEditar" class="btn btn-outline-secondary btn-sm">
                                <i class="bi bi-plus-lg"></i> Agregar otro teléfono
                            </button>
                        </div>

                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-lg"></i> Guardar cambios
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Datos de contacto -->
        <% const domicilio = persona.domicilio || {}; %>
        <% const tieneDomicilio = domicilio.calle || domicilio.localidad; %>
        <% const nacimiento = persona.nacimiento || {}; %>
        <% const tieneNacimiento = nacimiento.lugar || nacimiento.nacionalidad; %>
        <% if (persona.genero || tieneNacimiento || tieneDomicilio || (persona.telefonos && persona.telefonos.length > 0)) { %>
        <div class="card mb-4">
            <div class="card-header">Datos de contacto</div>
            <div class="card-body">
                <div class="row g-3">
                    <% if (persona.genero) { %>
                    <div class="col-12 col-sm-6 col-md-4">
                        <div class="text-secondary small"><i class="bi bi-person"></i> Identidad de género</div>
                        <div><%= persona.genero %></div>
                    </div>
                    <% } %>
                    <% if (tieneNacimiento) { %>
                    <div class="col-12 col-sm-6 col-md-4">
                        <div class="text-secondary small"><i class="bi bi-geo"></i> Nacimiento</div>
                        <div>
                            <% if (nacimiento.lugar) { %><%= nacimiento.lugar %><% } %>
                            <% if (nacimiento.nacionalidad) { %><% if (nacimiento.lugar) { %> — <% } %><%= nacimiento.nacionalidad %><% } %>
                            <% if (nacimiento.provincia || nacimiento.localidad) { %>
                            <br>
                            <%= nacimiento.localidad || '' %><% if (nacimiento.localidad && nacimiento.distrito) { %>, <% } %><%= nacimiento.distrito || '' %><% if ((nacimiento.localidad || nacimiento.distrito) && nacimiento.provincia) { %>, <% } %><%= nacimiento.provincia || '' %>
                            <% } %>
                        </div>
                    </div>
                    <% } %>
                    <% if (tieneDomicilio) { %>
                    <div class="col-12 col-sm-6 col-md-4">
                        <div class="text-secondary small"><i class="bi bi-house"></i> Domicilio</div>
                        <div>
                            <%= domicilio.calle || '' %><% if (domicilio.numero) { %> <%= domicilio.numero %><% } %><% if (domicilio.piso) { %>, piso <%= domicilio.piso %><% } %><% if (domicilio.depto) { %> depto <%= domicilio.depto %><% } %>
                            <% if (domicilio.localidad || domicilio.partido || domicilio.provincia) { %><br><%= domicilio.localidad || '' %><% if (domicilio.partido) { %>, <%= domicilio.partido %><% } %><% if (domicilio.provincia) { %>, <%= domicilio.provincia %><% } %><% } %>
                        </div>
                    </div>
                    <% } %>
                    <% if (persona.telefonos && persona.telefonos.length > 0) { %>
                    <div class="col-12 col-sm-6 col-md-4">
                        <div class="text-secondary small"><i class="bi bi-telephone"></i> Teléfonos</div>
                        <% persona.telefonos.forEach(function (telefono) { %>
                        <div><%= telefono.descripcion ? telefono.descripcion + ': ' : '' %><%= telefono.numero %></div>
                        <% }); %>
                    </div>
                    <% } %>
                </div>
            </div>
        </div>
        <% } %>

        <!-- Personas responsables -->
        <div class="card mb-4">
            <div class="card-header">Personas responsables</div>
            <div class="card-body">
                <% if (responsables.length === 0) { %>
                <p class="text-muted">Todavía no hay ninguna persona responsable cargada.</p>
                <% } else { %>
                <div class="row g-3 mb-4">
                    <% responsables.forEach(function (vinculo) { %>
                    <% const adulto = vinculo.adultoResponsableId; %>
                    <div class="col-12 col-md-6">
                        <div class="border rounded p-3 h-100">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <span class="badge text-bg-secondary mb-1"><%= vinculo.vinculo %></span>
                                    <div class="fw-bold"><%= adulto.apellido %>, <%= adulto.nombre %></div>
                                    <% if (adulto.numeroDocumento) { %>
                                    <div class="text-secondary small">
                                        <%= adulto.tipoDocumento === 'Documento extranjero' ? (adulto.documentoExtranjeroTipo || 'Doc.') : adulto.tipoDocumento %>
                                        <%= adulto.numeroDocumento %>
                                    </div>
                                    <% } else if (adulto.tipoDocumento && adulto.tipoDocumento !== 'DNI') { %>
                                    <div class="text-secondary small"><%= adulto.tipoDocumento %></div>
                                    <% } %>
                                </div>
                                <form action="/estudiantes/<%= claveEstudiante %>/responsables/<%= vinculo._id %>/eliminar" method="POST">
                                    <button type="submit" class="btn btn-outline-danger btn-sm" aria-label="Quitar">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                            <div class="small mt-2">
                                <% if (vinculo.convive) { %>
                                <div><i class="bi bi-house-check"></i> Convive con el/la estudiante</div>
                                <% } else if (adulto.domicilio && (adulto.domicilio.calle || adulto.domicilio.localidad)) { %>
                                <div>
                                    <i class="bi bi-house"></i>
                                    <%= adulto.domicilio.calle || '' %><% if (adulto.domicilio.numero) { %> <%= adulto.domicilio.numero %><% } %>
                                    <% if (adulto.domicilio.localidad) { %>, <%= adulto.domicilio.localidad %><% } %>
                                </div>
                                <% } %>
                                <% if (adulto.telefonos && adulto.telefonos.length > 0) { %>
                                <% adulto.telefonos.forEach(function (telefono) { %>
                                <div><i class="bi bi-telephone"></i> <%= telefono.descripcion ? telefono.descripcion + ': ' : '' %><%= telefono.numero %></div>
                                <% }); %>
                                <% } %>
                                <% if (adulto.correoElectronico) { %>
                                <div><i class="bi bi-envelope"></i> <%= adulto.correoElectronico %></div>
                                <% } %>
                            </div>
                        </div>
                    </div>
                    <% }); %>
                </div>
                <% } %>

                <!-- Agregar responsable -->
                <form action="/estudiantes/<%= claveEstudiante %>/responsables" method="POST">
                    <div class="row g-3 mb-3">
                        <div class="col-6 col-md-3">
                            <label class="form-label">Vínculo</label>
                            <select name="vinculo" class="form-select" required>
                                <option value="Madre">Madre</option>
                                <option value="Padre">Padre</option>
                                <option value="Tutor">Tutor</option>
                                <option value="Tutora">Tutora</option>
                                <option value="Otro">Otro</option>
                            </select>
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="form-label">¿Convive con el/la estudiante?</label>
                            <select name="convive" id="conviveResponsable" class="form-select">
                                <option value="si" selected>Sí</option>
                                <option value="no">No</option>
                            </select>
                        </div>
                        <div class="col-12 col-sm-6 col-md-3">
                            <label class="form-label">Apellido</label>
                            <input type="text" name="apellido" class="form-control" required>
                        </div>
                        <div class="col-12 col-sm-6 col-md-3">
                            <label class="form-label">Nombre</label>
                            <input type="text" name="nombre" class="form-control" required>
                        </div>
                        <%- include('../partials/documentoFields') %>
                        <div class="col-6 col-md-3">
                            <label class="form-label">Nacionalidad</label>
                            <%- include('../partials/nacionalidadSelect') %>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label">Correo electrónico</label>
                            <input type="email" name="correoElectronico" class="form-control">
                        </div>
                    </div>

                    <div id="domicilioResponsable">
                        <h2 class="h6 fw-bold d-flex align-items-center gap-2 mb-3">
                            <i class="bi bi-house"></i> Domicilio <span class="text-secondary fw-normal small">(si no convive)</span>
                        </h2>
                        <div class="row g-3 mb-3">
                            <%- include('../partials/domicilioFields') %>
                        </div>
                    </div>

                    <h2 class="h6 fw-bold d-flex align-items-center gap-2 mb-3">
                        <i class="bi bi-telephone"></i> Teléfonos <span class="text-secondary fw-normal small">(opcional)</span>
                    </h2>
                    <div class="mb-3">
                        <div id="telefonosContainerResponsable">
                            <div class="row g-2 mb-2 align-items-center telefono-fila">
                                <div class="col-5">
                                    <input type="text" name="telefonoDescripcion" class="form-control" placeholder="Ej: Celular">
                                </div>
                                <div class="col-6">
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="bi bi-telephone"></i></span>
                                        <input type="tel" name="telefonoNumero" class="form-control" placeholder="Ej: 11 5555-5555">
                                    </div>
                                </div>
                                <div class="col-1">
                                    <button type="button" class="btn btn-outline-danger btn-quitar-telefono" aria-label="Quitar">&times;</button>
                                </div>
                            </div>
                        </div>
                        <button type="button" id="btnAgregarTelefonoResponsable" class="btn btn-outline-secondary btn-sm">
                            <i class="bi bi-plus-lg"></i> Agregar otro teléfono
                        </button>
                    </div>

                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-lg"></i> Agregar responsable
                    </button>
                </form>
            </div>
        </div>

        <!-- Trayectoria: situacion actual (relacion vigente con un curso, con sus
             asignaturas) + historial de inscripciones anteriores agrupado por ciclo
             lectivo, todo en una sola card. Las materias en si (agregar/calificar) ya no
             viven aca - se editan junto con la relacion en /cursada/editar, ver el boton
             "Editar" de abajo. -->
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Trayectoria</span>
                <% if (vigente) { %>
                <a href="/estudiantes/<%= claveEstudiante %>/cursada/editar" class="btn btn-outline-primary btn-sm">
                    <i class="bi bi-pencil"></i> Editar
                </a>
                <% } %>
            </div>
            <div class="card-body">
                <% if (!vigente) { %>
                <p class="text-muted mb-0">No tiene ninguna inscripción vigente.</p>
                <% } else { %>
                <p class="mb-1">
                    <strong><%= vigente.cursoId.clave %></strong> — <%= vigente.cursoId.institucionId.nombre %>
                    <span class="text-secondary">· Ciclo lectivo <%= vigente.cicloLectivo %></span>
                </p>
                <p class="text-secondary mb-2">
                    Desde <%= vigente.fechaAlta.toLocaleDateString('es-AR') %> — <%= vigente.motivoAlta %>
                    <% if (vigente.numeroRegistro) { %> · N° de registro <%= vigente.numeroRegistro %><% } %>
                    <% if (vigente.procedencia) { %> · Viene de <%= vigente.procedencia %><% } %>
                </p>

                <% if (materiasEnCurso.length > 0) { %>
                <p class="mb-1 mt-3"><strong>Materias en curso:</strong></p>
                <div class="table-responsive mb-2">
                <table class="table table-sm mb-0">
                    <thead>
                        <tr>
                            <th>Materia</th>
                            <th>Año</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% materiasEnCurso.forEach(function (cursada) { %>
                        <tr>
                            <td><%= cursada.asignaturaId.nombre %></td>
                            <td><%= cursada.asignaturaId.anioId ? cursada.asignaturaId.anioId.clave : '—' %></td>
                        </tr>
                        <% }); %>
                    </tbody>
                </table>
                </div>
                <% } %>

                <form action="/estudiantes/<%= claveEstudiante %>/inscripciones/<%= vigente._id %>/baja" method="POST" class="row g-2 mt-2">
                    <div class="col-md-4">
                        <input type="date" name="fechaBaja" class="form-control form-control-sm" required>
                    </div>
                    <div class="col-md-5">
                        <input type="text" name="motivoBaja" class="form-control form-control-sm" placeholder="Motivo de la baja (ej: abandono, cambio de escuela)" required>
                    </div>
                    <div class="col-md-3">
                        <button type="submit" class="btn btn-outline-danger btn-sm w-100">Dar de baja</button>
                    </div>
                </form>
                <% } %>

                <% if (trayectoria.length > 0) { %>
                <hr class="my-4">
                <h2 class="h6 fw-bold mb-3">Historial</h2>
                <% trayectoria.forEach(function (ciclo, i) { %>
                <div class="<%= i > 0 ? 'mt-4 pt-4 border-top' : '' %>">
                    <h3 class="h6 fw-bold">Ciclo lectivo <%= ciclo.cicloLectivo %></h3>

                    <div class="table-responsive">
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr>
                                <th>Curso</th>
                                <th>Institución</th>
                                <th>N° de registro</th>
                                <th>Alta</th>
                                <th>Motivo de alta</th>
                                <th>Viene de</th>
                                <th>Baja</th>
                                <th>Motivo de baja</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% ciclo.inscripciones.forEach(function (inscripcion) { %>
                            <tr>
                                <td><%= inscripcion.cursoId.clave %></td>
                                <td><%= inscripcion.cursoId.institucionId.nombre %></td>
                                <td><%= inscripcion.numeroRegistro || '—' %></td>
                                <td><%= inscripcion.fechaAlta.toLocaleDateString('es-AR') %></td>
                                <td><%= inscripcion.motivoAlta %></td>
                                <td><%= inscripcion.procedencia || '—' %></td>
                                <td><%= inscripcion.fechaBaja ? inscripcion.fechaBaja.toLocaleDateString('es-AR') : '—' %></td>
                                <td><%= inscripcion.motivoBaja || '—' %></td>
                            </tr>
                            <% }); %>
                        </tbody>
                    </table>
                    </div>
                </div>
                <% }); %>
                <% } %>
            </div>
        </div>
    </div>

    <script src="/js/telefonos.js"></script>
    <script src="/js/tipoDocumento.js"></script>
    <script src="/js/domicilio.js"></script>
    <script src="/js/nacimiento.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const alertas = document.querySelectorAll('.auto-close');
            alertas.forEach(function (alerta) {
                setTimeout(function () {
                    new bootstrap.Alert(alerta).close();
                }, 5000);
            });

            initTelefonos('#telefonosContainerResponsable', '#btnAgregarTelefonoResponsable');
            initTipoDocumento('#tipoDocumentoSelect', '#numeroDocumentoWrap', '#estadoDniWrap', '#documentoExtranjeroWrap');
            initDomicilio({
                provinciaSelect: '#domicilioProvinciaSelect',
                distritoSelect: '#domicilioDistritoSelect',
                localidadSelect: '#domicilioLocalidadSelect',
                calleInput: '#domicilioCalleInput',
                calleList: '#domicilioCalleList'
            });

            // Form de "Editar estudiante" - mismos init*(...) que el alta, pero con los ids
            // sufijados "Editar" (ver idSufijo en los partials) para no chocar con los del
            // form de "Agregar responsable" de arriba, y precargados con lo que ya tenia
            // guardado esta Persona (ver /js/nacimiento.js y /js/domicilio.js).
            initTelefonos('#telefonosContainerEditar', '#btnAgregarTelefonoEditar');
            initTipoDocumento('#tipoDocumentoSelectEditar', '#numeroDocumentoWrapEditar', '#estadoDniWrapEditar', '#documentoExtranjeroWrapEditar');
            initNacimiento({
                lugarSelect: '#nacimientoLugarSelectEditar',
                nacionalidadInput: '#nacionalidadInputEditar',
                extranjeroWrap: '#nacimientoExtranjeroWrapEditar',
                extranjeroInput: '#nacimientoLocalidadTextoEditar',
                provinciaWrap: '#nacimientoProvinciaWrapEditar',
                provinciaSelect: '#nacimientoProvinciaSelectEditar',
                distritoWrap: '#nacimientoDistritoWrapEditar',
                distritoSelect: '#nacimientoDistritoSelectEditar',
                localidadWrap: '#nacimientoLocalidadWrapEditar',
                localidadSelect: '#nacimientoLocalidadSelectEditar',
                provinciaInicial: '<%= nacimiento.provincia || "" %>',
                distritoInicial: '<%= nacimiento.distrito || "" %>',
                localidadInicial: '<%= nacimiento.lugar === "Argentina" ? (nacimiento.localidad || "") : "" %>'
            });
            initDomicilio({
                provinciaSelect: '#domicilioProvinciaSelectEditar',
                distritoSelect: '#domicilioDistritoSelectEditar',
                localidadSelect: '#domicilioLocalidadSelectEditar',
                calleInput: '#domicilioCalleInputEditar',
                calleList: '#domicilioCalleListEditar',
                provinciaInicial: '<%= domicilio.provincia || "" %>',
                distritoInicial: '<%= domicilio.partido || "" %>',
                localidadInicial: '<%= domicilio.localidad || "" %>'
            });

            // El domicilio del responsable solo se pide si NO convive con el estudiante.
            const conviveSelect = document.getElementById('conviveResponsable');
            const domicilioBlock = document.getElementById('domicilioResponsable');
            function actualizarDomicilioVisible() {
                domicilioBlock.style.display = conviveSelect.value === 'no' ? '' : 'none';
            }
            if (conviveSelect && domicilioBlock) {
                conviveSelect.addEventListener('change', actualizarDomicilioVisible);
                actualizarDomicilioVisible();
            }

            // Baja real: el boton de confirmar solo se habilita si lo tipeado coincide
            // exactamente con la clave del estudiante (ver modalEliminarEstudiante arriba).
            const confirmarClaveEliminar = document.getElementById('confirmarClaveEliminar');
            const btnConfirmarEliminar = document.getElementById('btnConfirmarEliminar');
            if (confirmarClaveEliminar && btnConfirmarEliminar) {
                confirmarClaveEliminar.addEventListener('input', function () {
                    btnConfirmarEliminar.disabled = confirmarClaveEliminar.value.trim() !== '<%= claveEstudiante %>';
                });
            }
        });
    </script>
</body>
</html>
