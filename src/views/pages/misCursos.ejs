<!DOCTYPE html>
<html lang="es" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Trayectorias - Mis cursos</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</head>
<body>
    <%- include('../partials/msj') %>
    <%- include('../partials/nav') %>

    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
            <div>
                <h1 class="h3 fw-bold mb-0"><%= cargo.rolId.nivelAcceso === 'preceptor' ? 'Cursos designados' : 'Cursos' %></h1>
                <p class="text-secondary mb-0">
                    <%= cargo.institucionId.nombre %>
                    <% if (cargo.rolId.nivelAcceso === 'preceptor') { %> · Ciclo lectivo <%= anioActual %><% } %>
                </p>
            </div>
            <% if (cargo.rolId.nivelAcceso === 'total') { %>
            <a href="/inicio" class="btn btn-outline-secondary btn-sm">Volver a inicio</a>
            <% } %>
        </div>

        <div class="card">
            <div class="card-header">Listado (<%= cursos.length %>)</div>
            <div class="card-body p-0">
                <% if (cursos.length === 0) { %>
                <p class="text-muted p-3 mb-0">
                    <% if (cargo.rolId.nivelAcceso === 'preceptor') { %>
                    Todavía no tenés cursos designados para este ciclo lectivo.
                    <% } else { %>
                    Todavía no hay cursos cargados en esta institución.
                    <% } %>
                </p>
                <% } else { %>
                <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Curso</th>
                            <th>Año</th>
                            <th>Turno</th>
                            <th>Orientación</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        <% cursos.forEach(function (curso) { %>
                        <tr>
                            <td>
                                <%= curso.clave %>
                                <% const pendientes = pendientesPorCurso.get(String(curso._id)); %>
                                <% if (pendientes) { %>
                                <a href="/mis-cursos/<%= curso.clave %>/reubicaciones" class="badge text-bg-warning text-decoration-none ms-1"
                                    title="Reubicaciones esperando confirmación"><i class="bi bi-arrow-left-right"></i> <%= pendientes %></a>
                                <% } %>
                            </td>
                            <td><%= curso.anioId.nombre %> "<%= curso.division %>"</td>
                            <td><%= curso.turnoId ? curso.turnoId.nombre : '—' %></td>
                            <td><%= curso.orientacionId ? curso.orientacionId.nombre : '—' %></td>
                            <td class="text-end">
                                <a href="/mis-cursos/<%= curso.clave %>" class="btn btn-outline-secondary btn-sm">Ver</a>
                            </td>
                        </tr>
                        <% }); %>
                    </tbody>
                </table>
                </div>
                <% } %>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const alertas = document.querySelectorAll('.auto-close');
            alertas.forEach(function (alerta) {
                setTimeout(function () {
                    new bootstrap.Alert(alerta).close();
                }, 5000);
            });
        });
    </script>
</body>
</html>
