<!DOCTYPE html>
<html lang="es" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Trayectorias - <%= cargo.asignaturaId.nombre %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</head>
<body>
    <%- include('../partials/msj') %>
    <%- include('../partials/nav') %>

    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
            <h1 class="h3 fw-bold mb-0">
                <%= cargo.asignaturaId.nombre %>
                <span class="text-secondary fs-6 fw-normal d-block d-sm-inline">
                    <%= cargo.cursoId.clave %> · <%= cargo.institucionId.nombre %>
                </span>
            </h1>
            <% if (volverA) { %>
            <a href="<%= volverA %>" class="btn btn-outline-secondary btn-sm">Volver al curso</a>
            <% } %>
        </div>

        <!-- Elegir ciclo lectivo y periodo - recarga la pagina (GET), sin JS: el periodo
             cambia que campos pide la tabla de abajo (ver config, armado en el controller
             a partir de CONFIG_PERIODO). Dinamico a proposito - un solo periodo a la vez,
             no toda la planilla junta (pedido explicito del usuario). basePath distingue
             la propia materia de un profesor (/valoraciones/asignatura) de cualquier otra
             (/valoraciones/asignatura/:cargoId, para preceptor/EMATP/jerarquicos). -->
        <div class="card mb-4">
            <div class="card-body">
                <form action="<%= basePath %>" method="GET" class="row g-3 align-items-end">
                    <div class="col-6 col-md-3">
                        <label class="form-label">Ciclo lectivo</label>
                        <select name="cicloLectivo" class="form-select">
                            <% ciclosLectivos.forEach(function (anio) { %>
                            <option value="<%= anio %>" <%= anio === cicloLectivo ? 'selected' : '' %>><%= anio %></option>
                            <% }); %>
                        </select>
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label">Período</label>
                        <select name="periodo" class="form-select">
                            <% periodos.forEach(function (p) { %>
                            <option value="<%= p.clave %>" <%= p.clave === periodo ? 'selected' : '' %>><%= p.etiqueta %></option>
                            <% }); %>
                        </select>
                    </div>
                    <div class="col-6 col-md-3">
                        <button type="submit" class="btn btn-outline-secondary w-100">Ver</button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Carga de valoraciones para todos los estudiantes vigentes del curso, un
             periodo a la vez. Se guarda solo, por fila, apenas se toca un campo (ver
             /js/valoracionesAutosave.js) - no hay boton "Guardar": el circulo de la ultima
             columna indica si el ultimo cambio de esa fila se guardo bien (tilde verde,
             desaparece solo) o fallo (triangulo amarillo, se queda hasta el proximo intento). -->
        <div class="card">
            <div class="card-header">Estudiantes (<%= filas.length %>)</div>
            <div class="card-body p-0">
                <% if (filas.length === 0) { %>
                <p class="text-muted p-3 mb-0">No hay estudiantes inscriptos en este curso.</p>
                <% } else { %>
                <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle" id="tablaValoraciones">
                    <thead>
                        <tr>
                            <th>Estudiante</th>
                            <% if (config.valoraciones) { %><th>Valoración</th><% } %>
                            <% if (config.nota) { %><th>Nota</th><% } %>
                            <% if (config.recupero) { %><th>Recuperó C1</th><% } %>
                            <% if (config.observacion) { %><th>Observación</th><% } %>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        <% filas.forEach(function (fila) { %>
                        <% const id = fila.cursada._id; const v = fila.valoracion; %>
                        <tr data-cursada-id="<%= id %>">
                            <td>
                                <%= fila.estudiante.personaId.apellido %>, <%= fila.estudiante.personaId.nombre %>
                                <% if (fila.cursada.aprobada) { %>
                                <span class="badge text-bg-success ms-1">Aprobada</span>
                                <% } %>
                            </td>
                            <% if (config.valoraciones) { %>
                            <td>
                                <select data-campo="valoracion" class="form-select form-select-sm" style="min-width: 90px;">
                                    <option value="">—</option>
                                    <% config.valoraciones.forEach(function (opcion) { %>
                                    <option value="<%= opcion %>" <%= v && v.valoracion === opcion ? 'selected' : '' %>><%= opcion %></option>
                                    <% }); %>
                                </select>
                            </td>
                            <% } %>
                            <% if (config.nota) { %>
                            <td>
                                <input type="number" data-campo="nota" class="form-control form-control-sm" style="width: 80px;"
                                    min="<%= config.notaMin %>" max="<%= config.notaMax %>"
                                    value="<%= v && v.nota != null ? v.nota : '' %>">
                            </td>
                            <% } %>
                            <% if (config.recupero) { %>
                            <td class="text-center">
                                <input type="checkbox" data-campo="recupero" class="form-check-input" <%= v && v.recuperoSaberesC1 ? 'checked' : '' %>>
                            </td>
                            <% } %>
                            <% if (config.observacion) { %>
                            <td>
                                <input type="text" data-campo="observacion" class="form-control form-control-sm" value="<%= v && v.observacion ? v.observacion : '' %>">
                            </td>
                            <% } %>
                            <td class="text-center" style="width: 40px;">
                                <i data-indicador class="bi d-none"></i>
                            </td>
                        </tr>
                        <% }); %>
                    </tbody>
                </table>
                </div>
                <% } %>
            </div>
        </div>
    </div>

    <script src="/js/valoracionesAutosave.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const alertas = document.querySelectorAll('.auto-close');
            alertas.forEach(function (alerta) {
                setTimeout(function () {
                    new bootstrap.Alert(alerta).close();
                }, 5000);
            });

            initValoracionesAutosave({
                tabla: '#tablaValoraciones',
                url: '/valoraciones/asignatura/fila',
                cargoId: '<%= cargo._id %>',
                cicloLectivo: <%= cicloLectivo %>,
                periodo: '<%= periodo %>'
            });
        });
    </script>
</body>
</html>
