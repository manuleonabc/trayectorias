<!DOCTYPE html>
<html lang="es" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Trayectorias - Elegir institución</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</head>
<body>
    <%- include('../partials/msj') %>

    <div class="container py-5" style="max-width: 680px;">

        <h1 class="h4 fw-bold mb-1">Elegí qué institución vas a gestionar</h1>
        <p class="text-secondary mb-4">
            Tenés más de una institución disponible. Elegí con cuál querés operar en modo gestión.
        </p>

        <form action="/seleccionar-institucion" method="POST">
            <div class="list-group mb-4">
                <% instituciones.forEach(function (institucion, i) { %>
                <label class="list-group-item d-flex align-items-center gap-3">
                    <input
                        class="form-check-input mt-0"
                        type="radio"
                        name="institucionId"
                        value="<%= institucion._id %>"
                        <%= i === 0 ? 'checked' : '' %>
                        required>
                    <span><%= institucion.nombre %></span>
                </label>
                <% }); %>
            </div>
            <button type="submit" class="btn btn-primary">Ingresar</button>
        </form>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const alertas = document.querySelectorAll('.auto-close');
            alertas.forEach(function (alerta) {
                setTimeout(function () {
                    new bootstrap.Alert(alerta).close();
                }, 5000);
            });
        });
    </script>
</body>
</html>
