<!DOCTYPE html>
<html lang="es" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Trayectorias - Elegir cargo</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</head>
<body>
    <%- include('../partials/msj') %>

    <div class="container py-5" style="max-width: 680px;">

        <h1 class="h4 fw-bold mb-1">Elegí con qué cargo vas a ingresar</h1>
        <p class="text-secondary mb-4">
            Tenés más de un cargo asignado. Elegí con cuál querés operar en el sistema.
        </p>

        <form action="/seleccionar-cargo" method="POST">
            <div class="list-group mb-4">
                <% designaciones.forEach(function (designacion, i) { %>
                <% const cargo = designacion.cargoId; %>
                <label class="list-group-item d-flex align-items-center gap-3">
                    <input
                        class="form-check-input mt-0"
                        type="radio"
                        name="cargoId"
                        value="<%= cargo._id %>"
                        <%= i === 0 ? 'checked' : '' %>
                        required>
                    <span>
                        <strong><%= cargo.rolId ? cargo.rolId.nombre : '—' %></strong> — <%= cargo.institucionId.nombre %>
                        <% if (cargo.turnoId) { %> · <%= cargo.turnoId.nombre %><% } %>
                    </span>
                </label>
                <% }); %>
            </div>
            <button type="submit" class="btn btn-primary">Ingresar</button>
        </form>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const alertas = document.querySelectorAll('.auto-close');
            alertas.forEach(function (alerta) {
                setTimeout(function () {
                    new bootstrap.Alert(alerta).close();
                }, 5000);
            });
        });
    </script>
</body>
</html>
