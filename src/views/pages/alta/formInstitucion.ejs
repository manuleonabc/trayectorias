<!DOCTYPE html>
<html lang="es" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Trayectorias - Alta Institución</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</head>
<body>
    <%- include('../../partials/msj') %>

    <div class="container py-5" style="max-width: 680px;">

        <!-- Encabezado de la cuenta Google -->
        <div class="d-flex align-items-center gap-3 mb-4">
            <% if (usuario.foto) { %>
            <img src="<%= usuario.foto %>" alt="foto" class="rounded-circle" width="56" height="56">
            <% } %>
            <div>
                <div class="fw-semibold"><%= usuario.nombre %> <%= usuario.apellido %></div>
                <div class="text-secondary small"><%= usuario.email %></div>
            </div>
        </div>

        <h1 class="h4 fw-bold mb-1">Registro de institución</h1>
        <p class="text-secondary mb-4">
            Completá los datos de tu institución para solicitar el acceso al sistema.
            Un administrador revisará tu solicitud.
        </p>

        <form action="/alta/institucion" method="POST">

            <div class="card mb-4">
                <div class="card-header text-secondary small">Datos de la institución</div>
                <div class="card-body">
                    <div class="row g-3">

                        <div class="col-12">
                            <label class="form-label">Nombre de la institución <span class="text-danger">*</span></label>
                            <input
                                type="text"
                                name="nombre"
                                class="form-control"
                                value="<%= usuario.nombre %> <%= usuario.apellido %>"
                                required>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">CUE <span class="text-danger">*</span></label>
                            <input
                                type="text"
                                name="cue"
                                class="form-control"
                                placeholder="Ej: 060062500"
                                pattern="\d{9}"
                                title="El CUE debe tener 9 dígitos"
                                required>
                            <div class="form-text">9 dígitos sin espacios ni guiones</div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Número de institución</label>
                            <input
                                type="text"
                                name="numero"
                                class="form-control"
                                placeholder="Ej: 62">
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Nivel</label>
                            <select name="nivel" class="form-select">
                                <option value="">Seleccioná un nivel</option>
                                <option value="primaria">Primaria</option>
                                <option value="secundaria">Secundaria</option>
                                <option value="secundaria-tecnica">Secundaria Técnica</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Modalidad</label>
                            <select name="modalidad" class="form-select">
                                <option value="">Seleccioná una modalidad</option>
                                <option value="Secundaria">Secundaria</option>
                                <option value="Primaria">Primaria</option>
                                <option value="Técnica">Técnica</option>
                                <option value="Especial">Especial</option>
                                <option value="Adultos">Adultos</option>
                                <option value="Inicial">Inicial</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Partido / Localidad</label>
                            <input
                                type="text"
                                name="partido"
                                class="form-control"
                                value="La Matanza">
                        </div>

                        <div class="col-12">
                            <label class="form-label">Domicilio</label>
                            <input
                                type="text"
                                name="domicilio"
                                class="form-control"
                                placeholder="Calle, número, localidad">
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Teléfono</label>
                            <input
                                type="tel"
                                name="telefono"
                                class="form-control"
                                placeholder="Ej: 011-4000-1234">
                        </div>

                    </div>
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Enviar solicitud</button>
                <a href="/auth/logout" class="btn btn-outline-secondary">Cancelar y salir</a>
            </div>

        </form>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const alertas = document.querySelectorAll('.auto-close');
            alertas.forEach(function (alerta) {
                setTimeout(function () {
                    new bootstrap.Alert(alerta).close();
                }, 5000);
            });
        });
    </script>
</body>
</html>
