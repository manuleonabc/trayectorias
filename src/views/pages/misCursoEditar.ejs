<!DOCTYPE html>
<html lang="es" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Trayectorias - Editar <%= curso.clave %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</head>
<body>
    <%- include('../partials/msj') %>
    <%- include('../partials/nav') %>

    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
            <div>
                <h1 class="h3 fw-bold mb-0">Editar inscriptos</h1>
                <span class="text-secondary">
                    <%= curso.clave %> · <%= curso.institucionId.nombre %>
                </span>
            </div>
            <a href="/mis-cursos/<%= curso.clave %>" class="btn btn-outline-secondary btn-sm">Volver al curso</a>
        </div>

        <!-- Desvincular/reubicar/reordenar. Traer estudiantes de otros cursos vive en
             /mis-cursos/:cursoClave/reubicaciones, no aca. -->
        <div class="card">
            <div class="card-header">Estudiantes inscriptos (<%= inscripcionesVigentes.length %>)</div>
            <% if (inscripcionesVigentes.length === 0) { %>
            <div class="card-body">
                <p class="text-muted mb-0">Todavía no hay estudiantes inscriptos en este curso.</p>
            </div>
            <% } else { %>
            <div class="table-responsive">
            <table class="table table-hover mb-0" id="tablaEditarInscriptos">
                <thead>
                    <tr>
                        <th style="width: 140px;">N° de registro</th>
                        <th>Apellido</th>
                        <th>Nombre</th>
                        <th>DNI</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    <% inscripcionesVigentes.forEach(function (inscripcion, i) { %>
                    <% const persona = inscripcion.estudianteId.personaId; %>
                    <tr data-inscripcion-id="<%= inscripcion._id %>">
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="d-flex flex-column gap-1">
                                    <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-1"
                                        data-accion="subir" data-inscripcion-id="<%= inscripcion._id %>"
                                        <%= i === 0 ? 'disabled' : '' %> aria-label="Subir">
                                        <i class="bi bi-arrow-up"></i>
                                    </button>
                                    <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-1"
                                        data-accion="bajar" data-inscripcion-id="<%= inscripcion._id %>"
                                        <%= i === inscripcionesVigentes.length - 1 ? 'disabled' : '' %> aria-label="Bajar">
                                        <i class="bi bi-arrow-down"></i>
                                    </button>
                                </div>
                                <span data-campo="numeroRegistro"><%= inscripcion.numeroRegistro || '—' %></span>
                                <i class="bi bi-check-circle-fill text-success d-none" data-indicador title="Guardado"></i>
                            </div>
                        </td>
                        <td><%= persona.apellido %></td>
                        <td><%= persona.nombre %></td>
                        <td><%= persona.numeroDocumento || ('Legajo ' + inscripcion.estudianteId.legajo) %></td>
                        <td class="text-end">
                            <div class="d-flex gap-2 justify-content-end">
                                <button type="button" class="btn btn-outline-warning btn-sm"
                                    data-bs-toggle="modal" data-bs-target="#modalReubicar"
                                    data-inscripcion-id="<%= inscripcion._id %>"
                                    data-estudiante-nombre="<%= persona.apellido %>, <%= persona.nombre %>">
                                    <i class="bi bi-arrow-left-right"></i> Reubicar
                                </button>
                                <button type="button" class="btn btn-outline-danger btn-sm"
                                    data-bs-toggle="modal" data-bs-target="#modalDesvincular"
                                    data-inscripcion-id="<%= inscripcion._id %>"
                                    data-estudiante-nombre="<%= persona.apellido %>, <%= persona.nombre %>">
                                    <i class="bi bi-x-lg"></i> Desvincular
                                </button>
                            </div>
                        </td>
                    </tr>
                    <% }); %>
                </tbody>
            </table>
            </div>
            <% } %>
        </div>
    </div>

    <!-- Modal Desvincular - comun a toda la tabla, se completa con los data-* del boton que
         lo abrio (mismo patron que el modal de Transferir en misCursoDetalle.ejs). Pide
         fecha/motivo porque es una baja real de la Inscripcion (ver
         inscripcionRepo.darDeBaja), no algo que se pueda deshacer con un click. -->
    <div class="modal fade" id="modalDesvincular" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Desvincular estudiante</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form id="formDesvincular" method="POST">
                    <div class="modal-body">
                        <p class="mb-3">Vas a desvincular a <strong id="desvincularEstudianteNombre"></strong> de <strong><%= curso.clave %></strong>.</p>
                        <div class="mb-3">
                            <label class="form-label">Fecha de baja</label>
                            <input type="date" name="fechaBaja" class="form-control" value="<%= fechaHoy %>" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Motivo</label>
                            <input type="text" name="motivoBaja" class="form-control" placeholder="Ej: abandono, cambio de escuela" required>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-x-lg"></i> Desvincular
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Modal Reubicar - no mueve directo: crea una solicitud que confirma el curso de
         destino (ver reubicacion.controller.js::postSolicitarEnviar). Al confirmarse, las
         materias se anotan automaticamente segun el plan del año destino. -->
    <div class="modal fade" id="modalReubicar" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Reubicar estudiante</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form action="/mis-cursos/<%= curso.clave %>/reubicaciones/enviar" method="POST">
                    <div class="modal-body">
                        <input type="hidden" name="inscripcionId" id="reubicarInscripcionId">
                        <input type="hidden" name="volverA" value="editar">
                        <p class="mb-3">Vas a pedir que <strong id="reubicarEstudianteNombre"></strong> pase de <strong><%= curso.clave %></strong> a otro curso.</p>
                        <div class="alert alert-info py-2 px-3">El cambio se hace cuando lo confirme el curso de destino.</div>
                        <div class="mb-3">
                            <label class="form-label">Nuevo curso</label>
                            <select name="cursoDestinoId" class="form-select" required>
                                <option value="">Seleccioná un curso</option>
                                <% otrosCursos.forEach(function (c) { %>
                                <option value="<%= c._id %>"><%= c.clave %> — <%= c.anioId.nombre %> "<%= c.division %>"</option>
                                <% }); %>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Fecha</label>
                            <input type="date" name="fecha" class="form-control" value="<%= fechaHoy %>" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Motivo</label>
                            <input type="text" name="motivo" class="form-control" value="Cambio de curso" required>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-send"></i> Pedir reubicación
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="/js/misCursoEditarOrden.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const alertas = document.querySelectorAll('.auto-close');
            alertas.forEach(function (alerta) {
                setTimeout(function () { new bootstrap.Alert(alerta).close(); }, 5000);
            });

            const cursoClave = '<%= curso.clave %>';

            initMisCursoEditarOrden({ tabla: '#tablaEditarInscriptos', cursoClave: cursoClave });

            // Los dos modales son comunes a toda la tabla - se completan con los data-* del
            // boton que los abrio (mismo patron que el modal de Transferir).
            document.getElementById('modalDesvincular').addEventListener('show.bs.modal', function (evento) {
                const boton = evento.relatedTarget;
                document.getElementById('desvincularEstudianteNombre').textContent = boton.dataset.estudianteNombre;
                document.getElementById('formDesvincular').action =
                    '/mis-cursos/' + cursoClave + '/estudiantes/' + boton.dataset.inscripcionId + '/desvincular';
            });

            document.getElementById('modalReubicar').addEventListener('show.bs.modal', function (evento) {
                const boton = evento.relatedTarget;
                document.getElementById('reubicarEstudianteNombre').textContent = boton.dataset.estudianteNombre;
                document.getElementById('reubicarInscripcionId').value = boton.dataset.inscripcionId;
            });
        });
    </script>
</body>
</html>
