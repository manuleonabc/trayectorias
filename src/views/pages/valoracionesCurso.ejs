<!DOCTYPE html>
<html lang="es" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Trayectorias - <%= curso.clave %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</head>
<body>
    <%- include('../partials/msj') %>
    <%- include('../partials/nav') %>

    <div class="container-fluid py-4">
        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
            <h1 class="h3 fw-bold mb-0">
                Calificaciones — <%= curso.clave %>
                <span class="text-secondary fs-6 fw-normal d-block d-sm-inline">
                    <%= curso.institucionId.nombre %>
                </span>
            </h1>
            <a href="/mis-cursos/<%= curso.clave %>" class="btn btn-outline-secondary btn-sm">Volver al curso</a>
        </div>

        <!-- Elegir ciclo lectivo y periodo - recarga la pagina (GET), sin JS: un periodo a
             la vez, nunca todas las columnas de golpe. Nunca hay observacion aca (eso
             sigue siendo exclusivo del profesor cargando su propia materia desde
             /valoraciones/asignatura). -->
        <div class="card mb-4">
            <div class="card-body">
                <form action="/valoraciones/curso/<%= curso.clave %>" method="GET" class="row g-3 align-items-end">
                    <div class="col-6 col-md-3">
                        <label class="form-label">Ciclo lectivo</label>
                        <select name="cicloLectivo" class="form-select">
                            <% ciclosLectivos.forEach(function (anio) { %>
                            <option value="<%= anio %>" <%= anio === cicloLectivo ? 'selected' : '' %>><%= anio %></option>
                            <% }); %>
                        </select>
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label">Período</label>
                        <select name="periodo" class="form-select">
                            <% periodos.forEach(function (p) { %>
                            <option value="<%= p.clave %>" <%= p.clave === periodo ? 'selected' : '' %>><%= p.etiqueta %></option>
                            <% }); %>
                        </select>
                    </div>
                    <div class="col-6 col-md-3">
                        <button type="submit" class="btn btn-outline-secondary w-100">Ver</button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Matriz: todas las asignaturas x todos los estudiantes, un periodo a la vez.
             Autoguardado por celda (ver /js/valoracionesMatrizAutosave.js) - cada celda
             manda su propio cargoId al mismo POST /valoraciones/asignatura/fila que usa la
             pantalla "por asignatura". -->
        <div class="card">
            <div class="card-header">Estudiantes (<%= matriz.length %>) · Asignaturas (<%= cargosDelCurso.length %>)</div>
            <div class="card-body p-0">
                <% if (matriz.length === 0 || cargosDelCurso.length === 0) { %>
                <p class="text-muted p-3 mb-0">
                    <% if (matriz.length === 0) { %>No hay estudiantes inscriptos en este curso.
                    <% } else { %>Este curso todavía no tiene cargos de profesor generados.<% } %>
                </p>
                <% } else { %>
                <div class="table-responsive">
                <table class="table table-hover table-sm mb-0 align-middle" id="tablaMatrizValoraciones">
                    <thead>
                        <tr>
                            <th>Estudiante</th>
                            <% cargosDelCurso.forEach(function (cargoAsignatura) { %>
                            <th class="text-center" title="<%= cargoAsignatura.asignaturaId.nombre %>">
                                <%= cargoAsignatura.asignaturaId.nombreCorto %>
                            </th>
                            <% }); %>
                        </tr>
                    </thead>
                    <tbody>
                        <% matriz.forEach(function (fila) { %>
                        <tr>
                            <td class="text-nowrap">
                                <%= fila.estudiante.personaId.apellido %>, <%= fila.estudiante.personaId.nombre %>
                            </td>
                            <% fila.celdas.forEach(function (celda) { %>
                            <% const v = celda.valoracion; %>
                            <td class="text-center" style="min-width: 90px;"
                                data-cargo-id="<%= celda.cargoId %>"
                                data-cursada-id="<%= celda.cursada ? celda.cursada._id : '' %>">
                                <% if (!celda.cursada) { %>
                                —
                                <% } else { %>
                                <div class="d-flex flex-column align-items-center gap-1">
                                    <% if (config.valoraciones) { %>
                                    <select data-campo="valoracion" class="form-select form-select-sm">
                                        <option value="">—</option>
                                        <% config.valoraciones.forEach(function (opcion) { %>
                                        <option value="<%= opcion %>" <%= v && v.valoracion === opcion ? 'selected' : '' %>><%= opcion %></option>
                                        <% }); %>
                                    </select>
                                    <% } %>
                                    <% if (config.nota) { %>
                                    <input type="number" data-campo="nota" class="form-control form-control-sm" style="width: 60px;"
                                        min="<%= config.notaMin %>" max="<%= config.notaMax %>"
                                        value="<%= v && v.nota != null ? v.nota : '' %>">
                                    <% } %>
                                    <% if (config.recupero) { %>
                                    <label class="small text-nowrap">
                                        <input type="checkbox" data-campo="recupero" class="form-check-input" <%= v && v.recuperoSaberesC1 ? 'checked' : '' %>>
                                        Recuperó C1
                                    </label>
                                    <% } %>
                                    <i data-indicador class="bi d-none"></i>
                                </div>
                                <% } %>
                            </td>
                            <% }); %>
                        </tr>
                        <% }); %>
                    </tbody>
                </table>
                </div>
                <% } %>
            </div>
        </div>
    </div>

    <script src="/js/valoracionesMatrizAutosave.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const alertas = document.querySelectorAll('.auto-close');
            alertas.forEach(function (alerta) {
                setTimeout(function () {
                    new bootstrap.Alert(alerta).close();
                }, 5000);
            });

            initValoracionesMatrizAutosave({
                tabla: '#tablaMatrizValoraciones',
                url: '/valoraciones/asignatura/fila',
                cicloLectivo: <%= cicloLectivo %>,
                periodo: '<%= periodo %>'
            });
        });
    </script>
</body>
</html>
