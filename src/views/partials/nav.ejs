<nav class="navbar navbar-expand-lg navbar-dark <%= modoGestion ? 'bg-secondary' : 'bg-dark' %> shadow-sm border-bottom border-secondary border-opacity-25 mb-4">
    <div class="container-fluid">
        <a class="navbar-brand fw-bold d-flex align-items-center" href="/estudiantes">
            <i class="bi bi-signpost-split-fill me-2"></i>
            <span>Trayectorias</span>
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navTrayectorias">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navTrayectorias">
            <ul class="navbar-nav me-auto">

                <% if (nivelAccesoActivo === 'total') { %>
                <li class="nav-item">
                    <a class="nav-link" href="/inicio">
                        <i class="bi bi-house-door me-1"></i> Inicio
                    </a>
                </li>
                <% } %>

                <!-- Cursantes -->
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                        <i class="bi bi-mortarboard me-1"></i> Cursantes
                    </a>
                    <ul class="dropdown-menu shadow border-secondary">
                        <li><a class="dropdown-item" href="/estudiantes">Estudiantes</a></li>
                        <% if (nivelAccesoActivo === 'total' || nivelAccesoActivo === 'preceptor') { %>
                        <li><a class="dropdown-item" href="/mis-cursos">
                            <%= nivelAccesoActivo === 'preceptor' ? 'Mis cursos' : 'Curso' %>
                        </a></li>
                        <% } %>
                    </ul>
                </li>

                <% if (nivelAccesoActivo === 'profesor') { %>
                <li class="nav-item">
                    <a class="nav-link" href="/valoraciones/asignatura">
                        <i class="bi bi-clipboard-check me-1"></i> Valoraciones
                    </a>
                </li>
                <% } %>

                <!-- Cargos -->
                <% if (nivelAccesoActivo === 'total' || (usuario && usuario.tipo === 'personal')) { %>
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                        <i class="bi bi-briefcase me-1"></i> Cargos
                    </a>
                    <ul class="dropdown-menu shadow border-secondary">
                        <% if (nivelAccesoActivo === 'total') { %>
                        <li><a class="dropdown-item" href="/mis-cargos">Docentes</a></li>
                        <% } %>
                        <% if (usuario && usuario.tipo === 'personal') { %>
                        <li><a class="dropdown-item" href="/solicitudes-cargo">Solicitar cargo</a></li>
                        <% } %>
                        <% if (usuario && usuario.tipo === 'personal' && !modoGestion) { %>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item" href="/seleccionar-cargo">Cambiar de cargo</a></li>
                        <% } %>
                    </ul>
                </li>
                <% } %>

                <!-- Administración -->
                <% if (usuario && usuario.rol === 'admin' && modoGestion) { %>
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                        <i class="bi bi-gear me-1"></i> Administración
                    </a>
                    <ul class="dropdown-menu shadow border-secondary">
                        <li><a class="dropdown-item" href="/admin/usuarios">Usuarios</a></li>
                        <li><a class="dropdown-item" href="/admin/instituciones">Instituciones</a></li>
                        <li><a class="dropdown-item" href="/admin/roles">Roles</a></li>
                        <li><a class="dropdown-item" href="/admin/cargos">Cargos</a></li>
                        <li><a class="dropdown-item" href="/admin/turnos">Turnos</a></li>
                        <li><a class="dropdown-item" href="/admin/orientaciones">Orientaciones</a></li>
                        <li><a class="dropdown-item" href="/admin/anios">Años</a></li>
                        <li><a class="dropdown-item" href="/admin/cursos">Cursos</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item" href="/admin/solicitudes-cargo">Solicitudes de cargo</a></li>
                    </ul>
                </li>
                <% } %>

            </ul>

            <ul class="navbar-nav ms-auto align-items-lg-center">

                <% if (usuario && usuario.rol === 'admin' && modoGestion) { %>
                <li class="nav-item me-lg-2">
                    <span class="badge text-bg-danger">
                        Modo gestión<% if (institucionActiva) { %> — <%= institucionActiva %><% } %>
                    </span>
                </li>
                <% } %>

                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" role="button" data-bs-toggle="dropdown">
                        <% if (usuario) { %>
                        <div class="text-end me-2 d-none d-sm-block">
                            <small class="d-block text-white-50" style="font-size:1rem; line-height:1;"><%= usuario.email ? usuario.email.split('@')[0] : '' %>:</small>
                            <% if (escuelaActivaClave) { %>
                            <small class="d-block text-white-50" style="font-size:0.65rem; line-height:1.3;"><%= escuelaActivaClave %></small>
                            <% } %>
                            <span class="text-white small fw-semibold"><%= cargoActivoNombre || usuario.rol %></span>
                        </div>
                        <% } %>
                        <% if (usuario && usuario.foto) { %>
                        <img src="<%= usuario.foto %>" alt="Perfil" class="rounded-circle border border-2 border-info" width="38" height="38" style="object-fit:cover;">
                        <% } else { %>
                        <div class="rounded-circle bg-secondary d-flex align-items-center justify-content-center border border-2 border-info" style="width:38px; height:38px;">
                            <i class="bi bi-person-fill text-white"></i>
                        </div>
                        <% } %>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end shadow border-secondary">
                        <li>
                            <h6 class="dropdown-header d-flex flex-column">
                                <span class="text-white"><%= usuario && usuario.nombre ? usuario.nombre : 'Usuario' %></span>
                                <small class="text-muted" style="font-size:0.7rem;"><%= nivelAccesoActivo %></small>
                            </h6>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <% if (usuario && usuario.tipo === 'personal' && !modoGestion) { %>
                        <li><a class="dropdown-item" href="/seleccionar-cargo"><i class="bi bi-arrow-repeat me-2"></i>Cambiar de cargo</a></li>
                        <% } %>
                        <% if (usuario && usuario.rol === 'admin' && modoGestion) { %>
                        <li><a class="dropdown-item" href="/seleccionar-institucion"><i class="bi bi-building me-2"></i>Cambiar institución</a></li>
                        <% } %>
                        <li><a class="dropdown-item text-danger" href="/auth/logout"><i class="bi bi-box-arrow-right me-2"></i>Cerrar sesión</a></li>
                    </ul>
                </li>
            </ul>
        </div>
    </div>
</nav>