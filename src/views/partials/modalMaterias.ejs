<!-- Modal de materias: tiene que vivir dentro de un <form> para que sus checkboxes viajen
     con el resto al confirmar (ver /js/materiasSugeridas.js - se llena con fetch, pero
     el guardado sigue siendo el POST tradicional del form que lo contiene). -->
<div class="modal fade" id="<%= modalId %>" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Materias de la inscripción</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="text-secondary small">
                    Si no abrís este checklist, se anota igual en todas las materias del plan de
                    estudio de este año - usalo solo para los casos en que NO cursa todas: destildá
                    las que no correspondan (ej. ya aprobadas) y sumá materias atrasadas si hace
                    falta - no se pueden agregar materias de años posteriores.
                </p>
                <div data-lista="precargadas"></div>
                <div data-bloque="atrasadas" class="mt-3" style="display:none;">
                    <p class="fw-bold mb-1">Materias atrasadas (opcional)</p>
                    <div data-lista="atrasadas"></div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Listo</button>
            </div>
        </div>
    </div>
</div>
